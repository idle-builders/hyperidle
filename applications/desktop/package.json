{
	"name": "@hyperidle/desktop",
	"version": "1.0.0-rc.1",
	"private": true,
	"type": "module",
	"main": "src/main.ts",
	"scripts": {
		"dev": "npx tsx __scripts__/check-native.ts && NODE_OPTIONS='--import tsx' electron .",
		"build": "npx tsx __scripts__/bundle.ts",
		"build:dist": "electron-builder --config electron-builder.yml",
		"build:local": "bash __scripts__/build-local.sh",
		"check:native": "npx tsx __scripts__/check-native.ts",
		"check": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@electric-sql/pglite": "^0.5.4"
	},
	"devDependencies": {
		"@hono/node-server": "^2.0.6",
		"@hyperidle/agent-execution": "*",
		"@hyperidle/agent-orchestration": "*",
		"@hyperidle/core-api": "*",
		"@hyperidle/db": "*",
		"@hyperidle/event-bus": "*",
		"@types/ws": "^8.18.1",
		"electron": "43.1.1",
		"electron-builder": "^26.15.3",
		"esbuild": "^0.28.1",
		"vitest": "*",
		"ws": "^8.20.0",
		"zod": "^4.3.6"
	}
}
