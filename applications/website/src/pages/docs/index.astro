---
import Site from "../../layouts/Site.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";
import { DOCS_NAV, navItemUrl } from "../../lib/docs-nav.js";
import "../../styles/docs.css";

const base = import.meta.env.BASE_URL;

const sectionBlurb: Record<string, string> = {
	installation:
		"From zero to running: the getting-started walkthrough plus every deployment profile — laptop, VPS, cloud, shared backend, releases.",
	"user-guide":
		"Day-to-day HyperIdle: the interface, the three views, your agents, team rhythms, settings, and connections.",
	"developer-guide":
		"Contributor walkthroughs: setup, commands, testing, linting, and the conventions the repo builds by.",
	concepts: "The product story from the source docs — what HyperIdle is, how work flows, and how knowledge compounds.",
};
---

<Site
	title="Documentation — HyperIdle"
	description="Install HyperIdle, run your team, and understand the product — user guide, developer guide, and concepts rendered from the source docs."
>
	<div class="container docs-layout">
		<DocsSidebar entryId="" />
		<div class="docs-main">
			<p class="doc-crumb"><span class="here">Documentation</span></p>
			<div class="prose">
				<h1>Documentation</h1>
				<p>
					Install HyperIdle, run your team, and understand the product. Rendered from the
					source docs — ground truth, not brochureware. Start with
					<a href={navItemUrl("guides/user/getting-started", base)}>Getting started</a>.
				</p>
			</div>
			<div class="docs-hub">
				{
					DOCS_NAV.map((section) => (
						<section class="docs-hub-section" aria-labelledby={`hub-${section.id}`}>
							<h2 id={`hub-${section.id}`}>{section.title}</h2>
							<p class="docs-hub-blurb">{sectionBlurb[section.id]}</p>
							<ul>
								{section.items.map((item) => (
									<li>
										<a href={navItemUrl(item.id, base)}>{item.title}</a>
									</li>
								))}
							</ul>
						</section>
					))
				}
			</div>
		</div>
	</div>
</Site>
