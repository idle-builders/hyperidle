---
import { getCollection, render } from "astro:content";
import Site from "../../layouts/Site.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";
import { findNavSection } from "../../lib/docs-nav.js";
import "../../styles/docs.css";

export async function getStaticPaths() {
	const entries = await getCollection("docs");
	return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const base = import.meta.env.BASE_URL;
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const h1 = headings.find((h) => h.depth === 1)?.text;
const title = entry.data.title ?? h1 ?? entry.id;
const section = findNavSection(entry.id);
---

<Site title={`${title} — HyperIdle Docs`}>
	<div class="container docs-layout">
		<DocsSidebar entryId={entry.id} />
		<div class="docs-main">
			<p class="doc-crumb">
				<a href={`${base}docs/`}>Documentation</a>
				{
					section && (
						<>
							<span class="sep" aria-hidden="true">/</span>
							<span class="here">{section.title}</span>
						</>
					)
				}
			</p>
			<article class="prose">
				<Content />
			</article>
		</div>
	</div>
</Site>
