---
const principles = [
	{
		num: "01",
		title: "Build for the fast, not the enterprise",
		body: "No approval chains, no permission matrices, no governance theater. If a feature exists to reassure a risk-averse buyer who isn't ours, it gets cut.",
	},
	{
		num: "02",
		title: "Trust agents and humans",
		body: "Agents act by default. Gates are earned from real outcomes, never built first — security is a learning, not a wall.",
	},
	{
		num: "03",
		title: "Boil the lake",
		body: "AI makes completeness cheap. Test every path, read every doc — then stop at the edge of the task. Oceans aren't boilable.",
	},
	{
		num: "04",
		title: "Search before building",
		body: "First principles over familiar patterns. Ask what the user actually needs before adding anything.",
	},
];
---

<section id="ethos" aria-labelledby="ethos-h">
	<div class="container">
		<div class="sec-head reveal">
			<div>
				<span class="eyebrow">[ // Ethos ]</span>
				<h2 id="ethos-h">Built against the enterprise default.</h2>
				<p class="lead">Four principles decide what we build and what we cut. They ship in the box.</p>
			</div>
			<span class="sec-idx" aria-hidden="true">SEC.04</span>
		</div>

		<div data-stagger>
			{
				principles.map((p) => (
					<div class="ethos-row reveal">
						<span class="ethos-num" aria-hidden="true">
							{p.num}
						</span>
						<div>
							<h3 class="ethos-title">{p.title}</h3>
							<p class="ethos-body">{p.body}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
