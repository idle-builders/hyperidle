---
/**
 * Capabilities — plain-language feature blocks, asymmetric layout.
 * Every claim is one line; every grounding line is traceable to a rendered
 * doc page (linked), so an evaluator can check each statement at the source.
 */
const base = import.meta.env.BASE_URL;

interface Capability {
	idx: string;
	claim: string;
	grounding: string;
	href: string;
	doc: string;
	span: string;
}

const capabilities: Capability[] = [
	{
		idx: "01",
		claim: "Agents do the work",
		grounding:
			"Team agents pick up tasks, run sessions, and surface results through Conversations. Get a shaped team — Builder, Designer, Product Manager, and more — by installing the role-personas plugin.",
		href: `${base}docs/guides/user/agents/`,
		doc: "User guide · Agents",
		span: "cap-a",
	},
	{
		idx: "02",
		claim: "Work moves through tasks",
		grounding:
			"A task has a goal, an owner, and a done condition. Sequences emerge from dependencies — when one task completes, the tasks waiting on it start automatically. No central planner.",
		href: `${base}docs/product/how-work-flows/`,
		doc: "Concepts · How work flows",
		span: "cap-b",
	},
	{
		idx: "03",
		claim: "Knowledge compounds",
		grounding:
			"One canonical store, human-curated. What one agent learns flows back in — the tenth task is faster than the first.",
		href: `${base}docs/product/how-knowledge-compounds/`,
		doc: "Concepts · How knowledge compounds",
		span: "cap-c",
	},
	{
		idx: "04",
		claim: "Self-hosted, on your terms",
		grounding:
			"Signed macOS app, laptop dev with embedded PGlite, or managed cloud Postgres. Your machine, your server, your data.",
		href: `${base}docs/deployment/`,
		doc: "Installation · Deployment",
		span: "cap-d",
	},
	{
		idx: "05",
		claim: "Humans stay in charge",
		grounding:
			"When an agent needs a decision, it sends a review and waits. You give a verdict — approve, request changes, reject — and the agent resumes. You see every change.",
		href: `${base}docs/product/how-work-flows/`,
		doc: "Concepts · How work flows",
		span: "cap-e",
	},
];
---

<section class="caps" id="capabilities" aria-labelledby="caps-h">
	<div class="container">
		<div class="sec-head reveal">
			<h2 id="caps-h">What HyperIdle does</h2>
			<span class="sec-idx">[ 01 ]</span>
		</div>
		<div class="caps-grid" data-stagger>
			{
				capabilities.map((cap) => (
					<article class={`cap ${cap.span} reveal`}>
						<div class="cap-in">
							<span class="cap-idx">{cap.idx}</span>
							<h3 class="cap-claim">{cap.claim}</h3>
							<p class="cap-ground">{cap.grounding}</p>
							<a class="cap-doc" href={cap.href}>
								{cap.doc} →
							</a>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
