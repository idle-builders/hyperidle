---
const commands = [
	"git clone git@github.com:ambrovia/hyperidle.git",
	"cd hyperidle",
	"npm install",
	"npm run setup -- --profile laptop",
	"npm run dev",
];
---

<section id="self-host" aria-labelledby="host-h">
	<div class="container">
		<div class="sec-head reveal">
			<div>
				<span class="eyebrow">[ // Self-Host ]</span>
				<h2 id="host-h">Run it yourself.</h2>
				<p class="lead">
					Your machine, your keys, your data. HyperIdle self-hosts from a laptop to a cluster —
					five commands from clone to running app.
				</p>
			</div>
			<span class="sec-idx" aria-hidden="true">SEC.07</span>
		</div>

		<div class="host-grid">
			<div class="codeblock reveal">
				<button class="copy-btn" id="copyBtn" type="button" aria-label="Copy quickstart commands">
					Copy
				</button>
				<pre class="code-lines" id="quickstart"><span class="p">$</span> git clone git@github.com:ambrovia/hyperidle.git
<span class="p">$</span> cd hyperidle
<span class="p">$</span> npm install
<span class="p">$</span> npm run setup -- --profile laptop   <span class="c"># PGlite + migrations + bootstrap</span>
<span class="p">$</span> npm run dev                          <span class="c"># server :3001 + web :5173</span></pre>
			</div>

			<div class="profiles" data-stagger>
				<div class="profile reveal">
					<span class="profile-name">Laptop</span>
					<p class="profile-desc">
						Embedded PGlite, zero infrastructure. Clone, set up, run — the profile above.
					</p>
				</div>
				<div class="profile reveal">
					<span class="profile-name">VPS</span>
					<p class="profile-desc">
						Postgres + Docker Compose on your own box. One compose file, your keys, your box.
					</p>
				</div>
				<div class="profile reveal">
					<span class="profile-name">Cloud</span>
					<p class="profile-desc">
						Managed Postgres, same code path. Point DATABASE_URL at it and deploy.
					</p>
				</div>
			</div>

			<p class="host-note reveal">
				Prefer the app? Signed, notarized macOS build — <code
					>brew tap ambrovia/homebrew-tap &amp;&amp; brew install --cask hyperidle</code
				> — or download the DMG. Agents run on the host in every profile.
			</p>
		</div>
	</div>
</section>

<script define:vars={{ COMMANDS: commands.join("\n") }}>
	const copyBtn = document.getElementById("copyBtn");
	if (copyBtn) {
		copyBtn.addEventListener("click", () => {
			const ok = () => {
				copyBtn.textContent = "Copied ✓";
				copyBtn.classList.add("done");
				window.setTimeout(() => {
					copyBtn.textContent = "Copy";
					copyBtn.classList.remove("done");
				}, 1600);
			};
			const fallback = () => {
				const ta = document.createElement("textarea");
				ta.value = COMMANDS;
				ta.style.position = "fixed";
				ta.style.opacity = "0";
				document.body.appendChild(ta);
				ta.select();
				try {
					document.execCommand("copy");
					ok();
				} catch {}
				document.body.removeChild(ta);
			};
			if (navigator.clipboard && navigator.clipboard.writeText) {
				navigator.clipboard.writeText(COMMANDS).then(ok, fallback);
			} else fallback();
		});
	}
</script>
