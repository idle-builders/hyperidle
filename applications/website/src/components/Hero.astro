---
const base = import.meta.env.BASE_URL;
const GITHUB = "https://github.com/ambrovia/hyperidle";
---

<section class="hero" id="top" aria-labelledby="hero-h">
	<div class="container">
		<span class="eyebrow">[ Agentic Operating System ]</span>
		<h1 id="hero-h">
			The agentic operating system for <span class="hl">AI-first</span> teams.
		</h1>
		<p class="hero-sub">
			Flat teams of humans and AI agents, working side by side. Work ships as time-boxed bets —
			and everything your agents learn compounds into knowledge the next bet starts with.
		</p>
		<div class="hero-ctas">
			<a class="btn btn-primary" href={`${base}docs/guides/user/getting-started/`}
				>Install HyperIdle</a
			>
			<a class="btn btn-ghost" href={GITHUB}>Browse the source</a>
		</div>
		<p class="hero-meta">
			<span>Agents execute</span>
			<span>Humans validate</span>
			<span>Knowledge compounds</span>
		</p>
	</div>
</section>
