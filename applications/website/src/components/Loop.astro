---
const nodes = [
	{
		step: "01",
		name: "Bet",
		desc: "Shaped work with an explicit done condition. draft → active → completed or killed.",
	},
	{
		step: "02",
		name: "Task",
		desc: "One agent's unit of work. Dependencies unlock the next step — nobody pre-wires the graph.",
	},
	{
		step: "03",
		name: "Session",
		desc: "One bounded run on a task. Ends at the context window; notes carry the next one forward.",
	},
	{
		step: "04",
		name: "Review",
		desc: "Where human judgment lands: approve, request changes, edit, reject.",
	},
];
---

<section id="loop" aria-labelledby="loop-h">
	<div class="container">
		<div class="sec-head reveal">
			<div>
				<span class="eyebrow">[ // The Loop ]</span>
				<h2 id="loop-h">Work flows as bets.</h2>
				<p class="lead">
					No workflows, no DAGs, no central planner. Sequences emerge from task dependencies — a
					bet carries a done condition, not a deadline.
				</p>
			</div>
			<span class="sec-idx" aria-hidden="true">SEC.02</span>
		</div>

		<div class="loop-row reveal" data-stagger>
			{
				nodes.map((node, i) => (
					<>
						{i > 0 && <div class="conn" aria-hidden="true" />}
						<div class="loop-node">
							<span class="loop-step">{node.step}</span>
							<h3 class="loop-name">{node.name}</h3>
							<p class="loop-desc">{node.desc}</p>
						</div>
					</>
				))
			}
		</div>
		<p class="loop-foot reveal">
			<b>Routines</b> — recurring work with persistent memory · calendar / event / heartbeat
			triggers
		</p>
	</div>
</section>
