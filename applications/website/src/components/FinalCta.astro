---
/**
 * Final CTA — from zero to an agent responding on your machine.
 */
const base = import.meta.env.BASE_URL;
const GITHUB = "https://github.com/idle-builders/hyperidle";
---

<section class="final" id="start" aria-labelledby="final-h">
	<div class="container">
		<div class="final-box reveal">
			<h2 id="final-h">Your first task, running today.</h2>
			<p class="final-sub">
				Clone, setup, dev — from zero to an agent responding on your machine.
			</p>
			<div class="final-ctas">
				<a class="btn btn-primary" href={`${base}docs/guides/user/getting-started/`}
					>Install HyperIdle</a
				>
				<a class="btn btn-ghost" href={`${base}docs/`}>Read the docs</a>
			</div>
			<p class="final-src">
				Open source, self-hosted: <a href={GITHUB}>github.com/idle-builders/hyperidle</a>
			</p>
		</div>
	</div>
</section>
