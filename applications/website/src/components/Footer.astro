---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer>
	<div class="container">
		<div class="foot-grid">
			<div>
				<span class="wordmark">HYPERIDLE<span class="block" aria-hidden="true">▮</span></span>
				<p class="foot-tag">Agentic operating system<br />for AI-first teams.</p>
			</div>
			<nav aria-label="Docs">
				<p class="foot-h">Docs</p>
				<div class="foot-links">
					<a href={`${base}docs/guides/user/getting-started/`}>Installation</a>
					<a href={`${base}docs/guides/user/`}>User guide</a>
					<a href={`${base}docs/guides/developer/`}>Developer guide</a>
					<a href={`${base}docs/product/`}>Concepts</a>
				</div>
			</nav>
			<nav aria-label="Project">
				<p class="foot-h">Project</p>
				<div class="foot-links">
					<a href="https://github.com/idle-builders/hyperidle">Source</a>
					<a href={`${base}#why-not`}>What it's not</a>
				</div>
			</nav>
		</div>
		<div class="foot-bottom">
			<span>© {year} HYPERIDLE — BUILT BY HUMANS AND AGENTS</span>
			<span>EARLY AND SHIPPING — THE ROUGH EDGES ARE DOCUMENTED</span>
		</div>
	</div>
</footer>
