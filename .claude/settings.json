{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Read",
			"Edit",
			"Write",
			"Grep",
			"Glob",
			"Skill",
			"Agent",
			"TaskCreate",
			"TaskUpdate",
			"Bash(npm *)",
			"Bash(npm:*)",
			"Bash(npm install)",
			"Bash(npm install:*)",
			"Bash(npm install *)",
			"Bash(npm run *)",
			"Bash(npm run:*)",
			"Bash(npm test)",
			"Bash(npm test *)",
			"Bash(npm test:*)",
			"Bash(npx *)",
			"Bash(npx:*)",
			"Bash(git status)",
			"Bash(git diff *)",
			"Bash(git diff:*)",
			"Bash(git log *)",
			"Bash(git log:*)",
			"Bash(git add *)",
			"Bash(git add:*)",
			"Bash(git commit *)",
			"Bash(git commit:*)",
			"Bash(git commit -m ':*)",
			"Bash(git branch *)",
			"Bash(git branch:*)",
			"Bash(git checkout *)",
			"Bash(git checkout:*)",
			"Bash(git switch *)",
			"Bash(git switch:*)",
			"Bash(git stash *)",
			"Bash(git stash:*)",
			"Bash(git merge *)",
			"Bash(git merge:*)",
			"Bash(git rebase *)",
			"Bash(git rebase:*)",
			"Bash(git push *)",
			"Bash(git push:*)",
			"Bash(git worktree *)",
			"Bash(git worktree:*)",
			"Bash(gh pr *)",
			"Bash(gh pr:*)",
			"Bash(gh issue *)",
			"Bash(gh issue:*)",
			"Bash(gh api *)",
			"Bash(gh api:*)",
			"Bash(gh run *)",
			"Bash(gh run:*)",
			"Bash(mkdir *)",
			"Bash(mkdir:*)",
			"Bash(wc *)",
			"Bash(wc:*)",
			"Bash(cat *)",
			"Bash(cat:*)",
			"Bash(ls *)",
			"Bash(ls:*)",
			"Bash(grep *)",
			"Bash(grep:*)",
			"WebFetch(domain:nodejs.org)",
			"WebFetch(domain:hono.dev)",
			"WebFetch(domain:orm.drizzle.team)",
			"WebFetch(domain:react.dev)",
			"WebFetch(domain:vite.dev)",
			"WebFetch(domain:tailwindcss.com)",
			"WebFetch(domain:daisyui.com)",
			"WebFetch(domain:vitest.dev)",
			"WebFetch(domain:playwright.dev)",
			"WebFetch(domain:biomejs.dev)",
			"WebFetch(domain:docs.bullmq.io)",
			"WebFetch(domain:typescriptlang.org)",
			"WebFetch(domain:www.typescriptlang.org)",
			"WebFetch(domain:developer.mozilla.org)",
			"WebFetch(domain:docs.anthropic.com)",
			"WebFetch(domain:platform.claude.com)",
			"WebFetch(domain:code.claude.com)",
			"WebFetch(domain:sqlite.org)",
			"WebFetch(domain:www.sqlite.org)",
			"WebFetch(domain:postgresql.org)",
			"WebFetch(domain:www.postgresql.org)",
			"WebFetch(domain:floating-ui.com)",
			"WebFetch(domain:tanstack.com)",
			"WebFetch(domain:postcss.org)",
			"WebFetch(domain:redis.io)"
		],
		"deny": [
			"Bash(git push --force *)",
			"Bash(git reset --hard *)",
			"Read(./.env)",
			"Read(./.env.*)",
			"Read(./secrets/**)"
		],
		"defaultMode": "auto"
	},
	"includeGitInstructions": false,
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-main.sh\"",
						"timeout": 5
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/log-bash.sh\"",
						"timeout": 5
					}
				]
			}
		]
	},
	"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": true
}
