{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignore": [
		"**/.claude/**",
		".hermes/**",
		".opencode/**",
		"docs/product/.vitepress/**",
		"packages/eslint-plugin-design/test-fixtures/**",
		"packages/design-system/scripts/feedback-overlay.js",
		"plans/**",
		"packages/web/src/**/*.stories.tsx",
		"**/vitest-setup.ts",
		"**/vitest-integration-setup.ts",
		"**/test-setup.ts",
		"**/__tests__/setup.ts",
		"**/__tests__/_helpers.ts",
		"packages/server/src/harness/__tests__/require-harness.ts",
		"packages/server/src/test-fixtures.ts",
		"packages/web/e2e/fixtures.ts",
		"packages/server/src/middleware/response-validator.ts",
		"packages/server/src/services/service-connection-resolver.ts",
		"packages/server/src/harness/re-engage.ts",
		"packages/server/src/tools/live-proof-lanes.ts",
		"packages/server/src/__tests__/AL7-no-kernel-executor.test.ts"
	],
	"ignoreExportsUsedInFile": true,
	"exclude": ["duplicates"],
	"workspaces": {
		".": {
			"entry": ["scripts/*.ts!", "scripts/lib/**/*.ts!"],
			"project": ["scripts/**/*.ts"],
			"ignoreBinaries": ["vitepress"],
			"ignoreDependencies": ["@typescript-eslint/utils", "vitepress"]
		},
		"packages/shared": {},
		"packages/db": {
			"entry": [
				"src/migrate-pg.ts!",
				"src/bootstrap-pg.ts!",
				"src/seed-pg-cli.ts!",
				"src/pg-test-runner.ts!",
				"scripts/strip-public-schema.ts!"
			],
			"ignoreBinaries": ["drizzle-kit", "vitest"],
			"ignoreDependencies": ["zod"]
		},
		"packages/fabric": {},
		"packages/api-contract": {},
		"packages/server": {
			"entry": ["src/harness/harness-session-probe.ts!"],
			"ignoreBinaries": ["which", "codex", "claude", "opencode", "cursor", "gh"],
			"ignoreDependencies": ["@electric-sql/pglite"]
		},
		"packages/design-system": {
			"entry": [
				"src/**/*.stories.tsx",
				"scripts/*.ts!",
				"viewer/discovery.ts!",
				"viewer/tailwind.config.ts!",
				"viewer/postcss.config.ts!",
				"viewer/annotations/vite-plugin-annotations.ts!"
			],
			"ignoreBinaries": ["vite"],
			"ignoreDependencies": ["autoprefixer", "postcss", "@tiptap/pm"]
		},
		"packages/web": {
			"entry": [
				"src/api/client.ts!",
				"scripts/*.ts!",
				"vite.ah1.config.ts!",
				"vite.ah5.config.ts!",
				"vite.ah6.config.ts!"
			],
			"playwright": {
				"config": [
					"playwright.config.ts",
					"playwright.ah1.config.ts",
					"playwright.ah5.config.ts",
					"playwright.ah6.config.ts"
				]
			},
			"ignoreBinaries": ["vite", "playwright"],
			"ignoreDependencies": [
				"@electric-sql/pglite",
				"drizzle-orm",
				"@tiptap/react",
				"@tiptap/pm",
				"@tiptap/starter-kit",
				"@tiptap/extension-code-block-lowlight",
				"@tiptap/extension-table",
				"@tiptap/extension-table-row",
				"@tiptap/extension-table-cell",
				"@tiptap/extension-table-header",
				"@tiptap/extension-image",
				"@tiptap/extension-placeholder",
				"@tiptap/extension-link",
				"@tiptap/suggestion",
				"tiptap-markdown",
				"lowlight",
				"tippy.js"
			]
		},
		"packages/strategy-minimal": {},
		"packages/desktop": {
			"entry": ["src/preload.ts!", "scripts/bundle.ts!", "scripts/check-native.ts!"],
			"ignoreBinaries": ["electron", "electron-builder"],
			"ignoreDependencies": ["@electric-sql/pglite"]
		},
		"packages/eslint-plugin-design": {},
		"packages/eval": {
			"entry": ["src/judges.ts!", "src/cli.ts!"],
			"ignoreBinaries": ["tsx"],
			"ignoreDependencies": ["tsx"]
		},
		"scripts": {
			"entry": ["*.ts!", "lib/**/*.ts!", "__tests__/**/*.test.ts"],
			"project": ["**/*.ts"]
		}
	}
}
