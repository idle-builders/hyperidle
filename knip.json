{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignore": [
		"**/.claude/**",
		".hermes/**",
		".opencode/**",
		"docs/product/.vitepress/**",
		"packages/eslint-plugin-design/test-fixtures/**",
		"plans/**",
		"packages/web/src/**/*.stories.tsx",
		"**/vitest-setup.ts",
		"**/vitest-integration-setup.ts",
		"**/test-setup.ts",
		"**/__tests__/setup.ts",
		"**/__tests__/_helpers.ts",
		"packages/agent-execution/harness-registry/src/__tests__/require-harness.ts",
		"packages/server/src/test-fixtures.ts",
		"packages/web/e2e/fixtures.ts",
		"packages/web/src/pages/**/__fixtures__/**",
		"packages/web/src/preview/**",
		"packages/server/src/services/service-connection-resolver.ts",
		"packages/agent-execution/harness-registry/src/re-engage.ts",
		"packages/server/src/__tests__/AL7-no-kernel-executor.test.ts"
	],
	"ignoreExportsUsedInFile": true,
	"exclude": ["duplicates"],
	"ignoreIssues": {
		"packages/web/src/pages/review/ReviewRenderedInContext.tsx": ["exports"],
		"packages/server/src/services/proposed-call-workflow.ts": ["exports"],
		"packages/server/src/services/session-lifecycle.ts": ["exports"]
	},
	"workspaces": {
		".": {
			"entry": ["scripts/*.ts!", "scripts/lib/**/*.ts!"],
			"project": ["scripts/**/*.ts"],
			"ignoreBinaries": ["vitepress"],
			"ignoreDependencies": ["vitepress"]
		},
		"packages/shared": {},
		"packages/db": {
			"entry": [
				"src/migrate-pg.ts!",
				"src/bootstrap-pg.ts!",
				"src/seed-pg-cli.ts!",
				"src/pg-test-runner.ts!",
				"scripts/strip-public-schema.ts!"
			],
			"ignoreBinaries": ["drizzle-kit", "vitest"],
			"ignoreDependencies": ["zod"]
		},
		"packages/api-contract": {},
		"packages/server": {
			"ignoreDependencies": ["@electric-sql/pglite"]
		},
		"packages/agent-execution/harness-registry": {
			"entry": ["src/harness-session-probe.ts!"],
			"ignoreBinaries": ["which", "codex", "claude", "opencode", "cursor", "gh"]
		},
		"packages/design-system": {
			"entry": ["src/**/*.stories.tsx", "scripts/*.ts!"],
			"ignoreDependencies": ["@tiptap/pm"]
		},
		"packages/web": {
			"entry": [
				"src/api/client.ts!",
				"scripts/*.ts!",
				"vite.ah1.config.ts!",
				"vite.ah5.config.ts!",
				"vite.ah6.config.ts!"
			],
			"playwright": {
				"config": [
					"playwright.config.ts",
					"playwright.ah1.config.ts",
					"playwright.ah5.config.ts",
					"playwright.ah6.config.ts"
				]
			},
			"ignoreBinaries": ["vite", "playwright"],
			"ignoreDependencies": ["@electric-sql/pglite", "drizzle-orm"]
		},
		"packages/desktop": {
			"entry": ["src/preload.ts!", "scripts/bundle.ts!", "scripts/check-native.ts!"],
			"ignoreBinaries": ["electron", "electron-builder"],
			"ignoreDependencies": ["@electric-sql/pglite"]
		},
		"packages/eslint-plugin-design": {},
		"packages/eval": {
			"entry": ["src/judges.ts!", "src/cli.ts!"],
			"ignoreBinaries": ["tsx"],
			"ignoreDependencies": ["tsx"]
		},
		"scripts": {
			"entry": ["*.ts!", "lib/**/*.ts!", "__tests__/**/*.test.ts"],
			"project": ["**/*.ts"]
		}
	}
}
