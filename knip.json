{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignore": [
		"**/.claude/**",
		".hermes/**",
		".opencode/**",
		"docs/product/.vitepress/**",
		"tools/eslint-plugin-design/test-fixtures/**",
		"plans/**",
		"layers/core-ui/src/**/*.stories.tsx",
		"**/vitest-setup.ts",
		"**/vitest-integration-setup.ts",
		"**/test-setup.ts",
		"**/__tests__/setup.ts",
		"**/__tests__/_helpers.ts",
		"layers/agent-execution/harness-registry/src/__tests__/require-harness.ts",
		"layers/core-api/src/__testing__/test-fixtures.ts",
		"layers/core-ui/__e2e__/fixtures.ts",
		"layers/core-ui/__e2e__/known-pre-existing-failures.ts",
		"layers/core-ui/src/pages/**/__fixtures__/**",
		"layers/core-ui/src/__preview__/**",
		"layers/agent-execution/harness-registry/src/re-engage.ts",
		"layers/core-api/src/__tests__/AL7-no-kernel-executor.test.ts",
		"layers/core-api/src/__tests__/notifications-test-deps.ts",
		"layers/agent-orchestration/src/test-fixtures.ts",
		"layers/agent-orchestration/run-orchestration/src/__tests__/test-ports.ts",
		"layers/agent-orchestration/tool-handlers/src/__tests__/stub-ports.ts"
	],
	"ignoreExportsUsedInFile": true,
	"exclude": ["duplicates"],
	"ignoreIssues": {
		"layers/core-ui/src/pages/review/ReviewRenderedInContext.tsx": ["exports"]
	},
	"workspaces": {
		".": {
			"entry": ["scripts/*.ts!", "scripts/lib/**/*.ts!", "scripts/rules/**/*.ts!"],
			"project": ["scripts/**/*.ts"],
			"ignoreBinaries": ["vitepress"],
			"ignoreDependencies": ["vitepress"]
		},
		"framework/shared": {},
		"framework/db": {
			"entry": [
				"src/migrate-pg.ts!",
				"src/bootstrap-pg.ts!",
				"src/__testing__/seed-pg-cli.ts!",
				"src/__testing__/pg-test-runner.ts!",
				"__scripts__/strip-public-schema.ts!"
			],
			"ignoreBinaries": ["drizzle-kit", "vitest"],
			"ignoreDependencies": ["zod"]
		},
		"framework/api-contract": {},
		"layers/agent-execution/harness-registry": {
			"entry": ["src/harness-session-probe.ts!"],
			"ignoreBinaries": ["which", "codex", "claude", "opencode", "cursor", "gh"]
		},
		"framework/design-system": {
			"entry": ["src/**/*.stories.tsx", "__scripts__/*.ts!"],
			"ignoreDependencies": ["@tiptap/pm"]
		},
		"layers/core-ui": {
			"entry": [
				"__scripts__/*.ts!",
				"vite.ah1.config.ts!",
				"vite.ah5.config.ts!",
				"vite.ah6.config.ts!"
			],
			"playwright": {
				"config": [
					"playwright.config.ts",
					"playwright.ah1.config.ts",
					"playwright.ah5.config.ts",
					"playwright.ah6.config.ts"
				]
			},
			"ignoreBinaries": ["vite", "playwright"],
			"ignoreDependencies": ["@electric-sql/pglite", "drizzle-orm"]
		},
		"applications/desktop": {
			"entry": ["src/preload.ts!", "__scripts__/bundle.ts!", "__scripts__/check-native.ts!"],
			"ignoreBinaries": ["electron", "electron-builder"],
			"ignoreDependencies": ["@electric-sql/pglite"]
		},
		"tools/eslint-plugin-design": {},
		"tools/eval": {
			"entry": ["src/judges.ts!", "src/cli.ts!"],
			"ignoreBinaries": ["tsx"],
			"ignoreDependencies": ["tsx"]
		},
		"scripts": {
			"entry": ["*.ts!", "lib/**/*.ts!", "rules/**/*.ts!", "__tests__/**/*.test.ts"],
			"project": ["**/*.ts"]
		}
	}
}
