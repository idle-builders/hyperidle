{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignore": [
		"**/.claude/**",
		"docs/product/.vitepress/**",
		"packages/design-system/html/**",
		"packages/eslint-plugin-design/test-fixtures/**",
		"packages/design-system/scripts/feedback-overlay.js",
		"plans/**"
	],
	"ignoreExportsUsedInFile": true,
	"exclude": ["duplicates"],
	"workspaces": {
		".": {
			"entry": ["scripts/*.ts"],
			"ignoreBinaries": ["bin/pipeline", "vitepress"],
			"ignoreDependencies": ["@typescript-eslint/utils", "vitepress"]
		},
		"packages/shared": {},
		"packages/db": {
			"entry": ["src/migrate-pg.ts"]
		},
		"packages/fabric": {},
		"packages/api-contract": {},
		"packages/server": {
			"entry": ["src/harness/isolated-session-worker.ts"],
			"ignoreDependencies": []
		},
		"packages/design-system": {
			"entry": [
				"src/**/*.stories.tsx",
				"scripts/*.ts",
				"viewer/discovery.ts",
				"viewer/tailwind.config.ts",
				"viewer/postcss.config.ts"
			],
			"ignoreDependencies": ["autoprefixer", "postcss"],
			"playwright": {
				"config": [
					"playwright.config.ts",
					"playwright.l1.config.ts",
					"playwright.workbench.config.ts"
				]
			}
		},
		"packages/web": {
			"entry": [
				"src/**/*.stories.tsx",
				"src/api/client.ts",
				"scripts/*.ts",
				"vite.ah1.config.ts",
				"vite.ah5.config.ts"
			],
			"playwright": {
				"config": ["playwright.config.ts", "playwright.ah1.config.ts", "playwright.ah5.config.ts"]
			},
			"ignoreDependencies": ["@electric-sql/pglite", "drizzle-orm"]
		},
		"packages/pipeline": {},
		"packages/strategy-minimal": {},
		"packages/desktop": {
			"entry": ["src/preload.ts"],
			"ignoreBinaries": ["electron-builder"],
			"ignoreDependencies": ["@electric-sql/pglite"]
		},
		"packages/eslint-plugin-design": {},
		"packages/eval": {
			"entry": ["src/judges.ts"]
		},
		"scripts": {
			"entry": ["*.ts", "__tests__/**/*.test.ts"]
		}
	}
}
