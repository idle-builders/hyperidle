{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignore": [
		"**/.claude/**",
		".hermes/**",
		".opencode/**",
		"docs/product/.vitepress/**",
		"applications/website/.astro/**",
		"tools/eslint-plugin-design/test-fixtures/**",
		"plans/**",
		".pipeline/**",
		"layers/core-ui/src/**/*.stories.tsx",
		"**/vitest-setup.ts",
		"**/vitest-integration-setup.ts",
		"**/test-setup.ts",
		"**/__tests__/setup.ts",
		"**/__tests__/_helpers.ts",
		"layers/agent-execution/harness-registry/src/__tests__/require-binary.ts",
		"layers/agent-orchestration/connections/src/__tests__/require-binary.ts",
		"layers/agent-execution/harness-registry/src/__tests__/require-harness.ts",
		"layers/core-api/src/__testing__/test-fixtures.ts",
		"layers/core-ui/__e2e__/fixtures.ts",
		"layers/core-ui/__e2e__/known-pre-existing-failures.ts",
		"layers/core-ui/src/pages/**/__fixtures__/**",
		"layers/core-ui/src/__preview__/**",
		"layers/agent-execution/harness-registry/src/re-engage.ts",
		"layers/core-api/src/__tests__/AL7-no-kernel-executor.test.ts",
		"layers/core-api/src/__tests__/notifications-test-deps.ts",
		"layers/agent-orchestration/src/test-fixtures.ts",
		"layers/agent-orchestration/run-orchestration/src/__tests__/test-ports.ts",
		"layers/agent-orchestration/tool-handlers/src/__tests__/stub-ports.ts"
	],
	"ignoreExportsUsedInFile": true,
	"exclude": ["duplicates"],
	"ignoreIssues": {
		"layers/core-ui/src/pages/review/ReviewRenderedInContext.tsx": ["exports"]
	},
	"workspaces": {
		".": {
			"entry": ["vitest.integration.config.ts!", "eslint.design.config.ts!"]
		},
		"framework/domain-model": {},
		"framework/diagnostics": {},
		"framework/harness-capability": {},
		"framework/work-intent-port": {},
		"framework/event-bus": {},
		"framework/presentation-format": {},
		"framework/block-derivation": {},
		"framework/conversation-parts": {},
		"framework/filesystem-contract": {},
		"framework/cron": {},
		"framework/toon-codec": {},
		"framework/query-escaping": {},
		"framework/factory-defaults": {},
		"framework/host-process": {},
		"framework/http-middleware": {},
		"framework/credential-access": {},
		"framework/harness-protocol": {},
		"framework/tool-protocol": {},
		"framework/db": {
			"entry": [
				"src/migrate-pg.ts!",
				"src/__testing__/pg-test-runner.ts!",
				"__scripts__/strip-public-schema.ts!"
			],
			// pg-test-runner.ts spawns the `vitest` binary; vitest is a devDependency, which
			// the --production lane does not count, so only that lane reports it.
			"ignoreBinaries": ["vitest"]
		},
		"framework/api-contract": {},
		"layers/agent-execution/harness-registry": {
			"entry": ["src/harness-session-probe.ts!"]
		},
		"framework/design-system": {
			"entry": ["src/**/*.stories.tsx", "__scripts__/*.ts!"]
		},
		"layers/core-ui": {
			"entry": [
				"__scripts__/*.ts!",
				"vite.ah1.config.ts!",
				"vite.ah5.config.ts!",
				"vite.ah6.config.ts!"
			],
			"playwright": {
				"config": [
					"playwright.config.ts",
					"playwright.ah1.config.ts",
					"playwright.ah5.config.ts",
					"playwright.ah6.config.ts"
				]
			}
		},
		"applications/website": {
			// In the --production lane knip's Astro plugin registers astro.config.ts and
			// src/content.config.ts as dev-only entries, so the graph never reaches the
			// lib modules they import. Declare the lib modules as production entries —
			// for a static site the build-time modules ARE the production surface.
			"entry": ["src/lib/*.ts!"],
			// cookie is a resolution shim, never imported: astro's emitted prerender entry
			// needs cookie@2, and the monorepo hoists cookie@0.7.2 for express@5. Declared
			// in the package so Node's upward resolution from dist/.prerender/ finds the
			// nested copy (see JUSTIFIED_UNUSED in tools/repo-gates/src/lib/dep-manifest-verdict.ts).
			"ignoreDependencies": ["cookie"]
		},
		"applications/desktop": {
			"entry": ["src/preload.ts!", "__scripts__/bundle.ts!", "__scripts__/check-native.ts!"],
			// Never imported: marked external in __scripts__/bundle.ts and copied verbatim by
			// electron-builder.yml, so the WASM bundle loads from node_modules at runtime.
			"ignoreDependencies": ["@electric-sql/pglite"]
		},
		"tools/eslint-plugin-design": {},
		"tools/eval": {
			"entry": ["src/judges.ts!", "src/cli.ts!"]
		},
		"tools/governance": {
			"entry": [
				"src/governance-lint.ts!",
				"src/governance-floors.ts!",
				"src/governance-new-cells.ts!"
			]
		},
		"tools/repo-gates": {
			"entry": [
				"src/typecheck-gate.ts!",
				"src/dep-manifest-lint.ts!",
				"src/mock-inventory.ts!",
				"src/knip-production-test-files.mjs!"
			]
		},
		"tools/setup": {
			"entry": ["src/setup-cli.ts!", "src/bootstrap-pg.ts!", "src/seed-pg-cli.ts!"]
		},
		"tools/trace": {
			"entry": [
				"mcp-server.ts!",
				"trace-build.ts!",
				"trace-doors.ts!",
				"trace-events.ts!",
				"trace-uses.ts!"
			]
		}
	}
}
