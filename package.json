{
	"name": "hyperidle",
	"private": true,
	"version": "0.5.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"workspaces": [
		"layers/*",
		"layers/*/*",
		"framework/*",
		"applications/*",
		"tools/*"
	],
	"scripts": {
		"prepare": "sh scripts/install-git-hooks.sh || true",
		"dev": "concurrently --names server,web --prefix-colors blue,green \"npm run -w @hyperidle/remote-server dev\" \"npm run -w @hyperidle/core-ui dev\"",
		"dev:desktop": "concurrently --names web,desktop --prefix-colors green,blue \"npm run -w @hyperidle/core-ui dev\" \"npm run -w @hyperidle/desktop dev\"",
		"build": "npm run -w @hyperidle/core-ui build",
		"build:desktop": "npm run -w @hyperidle/core-ui build && npm run -w @hyperidle/desktop build",
		"build:desktop:local": "bash applications/desktop/__scripts__/build-local.sh",
		"start": "HYPERIDLE_STATIC_DIR=layers/core-ui/dist npm run -w @hyperidle/remote-server start",
		"test": "vitest run --changed=origin/main --passWithNoTests",
		"test:full": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:integration:service": "vitest run --config vitest.integration.config.ts --project service",
		"test:integration:harness": "vitest run --config vitest.integration.config.ts --project harness",
		"test:all": "npm run test:full && npm run test:integration",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "npm run -w @hyperidle/core-ui test:e2e",
		"test:e2e:full": "npm run -w @hyperidle/core-ui test:e2e:full",
		"test:e2e:ah1": "npm run -w @hyperidle/core-ui test:e2e:ah1",
		"test:e2e:ah5": "npm run -w @hyperidle/core-ui test:e2e:ah5",
		"check": "npx tsx tools/repo-gates/src/typecheck-gate.ts",
		"governance:floors": "npx tsx tools/governance/src/governance-floors.ts",
		"governance:new-cells": "npx tsx tools/governance/src/governance-new-cells.ts",
		"lint": "biome check . --reporter=summary && npx eslint . --quiet && npm run lint:design-css && npm run lint:design-profiles && npm run lint:az16-receipts && npm run lint:az16-audit && npx tsx tools/governance/src/governance-lint.ts --fixtures && npx tsx tools/governance/src/governance-lint.ts --attacks && npx tsx tools/governance/src/governance-lint.ts",
		"lint:biome": "biome check . --reporter=summary",
		"lint:eslint": "npx eslint . --quiet",
		"lint:governance": "npx tsx tools/governance/src/governance-lint.ts",
		"lint:governance:attacks": "npx tsx tools/governance/src/governance-lint.ts --attacks",
		"lint:governance:fixtures": "npx tsx tools/governance/src/governance-lint.ts --fixtures",
		"lint:design": "npx eslint --no-config-lookup --config eslint.design.config.ts 'layers/core-ui/src/**/*.{ts,tsx}' 'framework/design-system/src/**/*.{ts,tsx}'",
		"lint:design-css": "npx tsx tools/repo-gates/src/design-css-gate.ts",
		"lint:design-profiles": "npx tsx tools/repo-gates/src/design-profile-census.ts",
		"lint:az16-receipts": "npx tsx tools/repo-gates/src/az16-migration-receipt-gate.ts",
		"lint:az16-audit": "node .pipeline/work/AZ16/audit-checksum-gate.mjs",
		"lint:fix": "biome check --write .",
		"verify": "npm run check && npm run lint && npm run knip && npm run knip:production && npm run deps:check && npm run mock-inventory:check && npm run design:backlog:check && npm run build && npm run -w @hyperidle/desktop build",
		"verify:release": "npm run verify && npm run test:full && npm run test:integration && npm run test:e2e:full",
		"verify:quick": "npm run check && npm run lint && npm run knip && npm run knip:production && npm run deps:check",
		"db:generate": "npm run -w @hyperidle/db generate",
		"db:migrate": "npm run -w @hyperidle/db migrate",
		"db:seed:pg": "npx tsx tools/setup/src/seed-pg-cli.ts",
		"setup": "tsx tools/setup/src/setup-cli.ts",
		"test:pg": "npx tsx framework/db/src/__testing__/pg-test-runner.ts",
		"ds:inspect": "npx tsx framework/design-system/__scripts__/inspect-page.ts",
		"deps:check": "npx tsx tools/repo-gates/src/dep-manifest-lint.ts",
		"knip": "npx knip",
		"knip:production": "npx knip --include files && npx knip --production --include files,dependencies,unlisted,binaries --preprocessor ./tools/repo-gates/src/knip-production-test-files.mjs",
		"mock-inventory": "npx tsx tools/repo-gates/src/mock-inventory.ts",
		"mock-inventory:check": "npx tsx tools/repo-gates/src/mock-inventory.ts --check",
		"design:backlog": "npx tsx tools/repo-gates/src/design-backlog-drift.ts",
		"design:backlog:check": "npx tsx tools/repo-gates/src/design-backlog-drift.ts --check",
		"db:bootstrap:pg": "npx tsx tools/setup/src/bootstrap-pg.ts",
		"check:native": "npx tsx applications/desktop/__scripts__/check-native.ts",
		"eval": "npm run -w @hyperidle/eval eval",
		"eval:quick": "npm run -w @hyperidle/eval eval -- --quick",
		"docs:dev": "vitepress dev docs/product",
		"docs:build": "vitepress build docs/product"
	},
	"overrides": {
		"zod-validation-error": "^4.0.0",
		"vitest": "^4.1.9"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@typescript-eslint/parser": "^8.62.0",
		"@vitest/coverage-v8": "^4.1.9",
		"concurrently": "^10.0.3",
		"eslint": "^10.6.0",
		"eslint-plugin-design": "*",
		"eslint-plugin-drizzle": "^0.2.3",
		"eslint-plugin-react-compiler": "^19.1.0-rc.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"knip": "^6.23.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.0",
		"typescript-native": "npm:typescript@^7.0.2",
		"vitepress": "^1.6.4",
		"vitest": "^4.1.9"
	}
}
