{
	"name": "hyperidle",
	"private": true,
	"version": "0.5.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "concurrently --names server,web --prefix-colors blue,green \"npm run -w @hyperidle/server dev\" \"npm run -w @hyperidle/web dev\"",
		"dev:desktop": "concurrently --names web,desktop --prefix-colors green,blue \"npm run -w @hyperidle/web dev\" \"npm run -w @hyperidle/desktop dev\"",
		"build": "npm run -w @hyperidle/web build",
		"build:desktop": "npm run -w @hyperidle/web build && npm run -w @hyperidle/desktop build",
		"build:desktop:local": "bash packages/desktop/scripts/build-local.sh",
		"start": "HYPERIDLE_STATIC_DIR=packages/web/dist npm run -w @hyperidle/server start",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:all": "npm run test && npm run test:integration",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "npm run -w @hyperidle/web test:e2e",
		"test:e2e:ah1": "npm run -w @hyperidle/web test:e2e:ah1",
		"test:e2e:ah5": "npm run -w @hyperidle/web test:e2e:ah5",
		"test:e2e:ah6": "npm run -w @hyperidle/web test:e2e:ah6",
		"check": "npx tsx scripts/typecheck-gate.ts",
		"lint": "biome check . --reporter=summary && npx eslint . --quiet && npx tsx scripts/ag7-no-divergent-classes.ts && npx tsx scripts/honest-harness-guard.ts --check",
		"check:ag7-consistency": "npx tsx scripts/ag7-no-divergent-classes.ts",
		"lint:biome": "biome check . --reporter=summary",
		"lint:eslint": "npx eslint . --quiet",
		"lint:design": "npx eslint 'packages/web/src/**/*.tsx' 'packages/design-system/src/**/*.tsx'",
		"lint:fix": "biome check --write .",
		"harness-vocab-guard:check": "npx tsx scripts/harness-vocab-guard.ts --check",
		"ah5-mock-guard:check": "npx tsx scripts/ah5-no-mock-guard.ts",
		"ah6-mock-guard:check": "npx tsx scripts/ah6-no-mock-guard.ts",
		"honest-harness-guard": "npx tsx scripts/honest-harness-guard.ts",
		"honest-harness-guard:check": "npx tsx scripts/honest-harness-guard.ts --check",
		"honest-harness-guard:write-allowlist": "npx tsx scripts/honest-harness-guard.ts --write-allowlist",
		"verify": "npm run check && npm run lint && npm run knip && npm run knip:production && npm run mock-inventory:check && npm run demo-fixture-guard:check && npm run token-guard:check && npm run harness-vocab-guard:check && npm run ah5-mock-guard:check && npm run ah6-mock-guard:check && npm run build && npm run -w @hyperidle/desktop build && npx tsx scripts/verify-attest.ts",
		"verify:quick": "npm run check && npm run lint && npm run knip && npm run knip:production",
		"db:generate": "npm run -w @hyperidle/db generate",
		"db:migrate": "npm run -w @hyperidle/db migrate",
		"db:seed:pg": "npx tsx packages/db/src/seed-pg-cli.ts",
		"setup": "tsx packages/db/src/setup-cli.ts",
		"test:pg": "npx tsx packages/db/src/pg-test-runner.ts",
		"ds:serve": "npm run -w @hyperidle/design-system serve",
		"ds:bless": "vitest run -u packages/design-system/src/__tests__/catalog-snapshot.test.tsx",
		"ds:inspect": "npx tsx packages/design-system/scripts/inspect-page.ts",
		"obs:env": "npx tsx scripts/obs.ts env",
		"obs:smoke": "npx tsx scripts/obs.ts smoke",
		"obs:run": "npx tsx scripts/obs.ts run",
		"obs:collector": "npx tsx scripts/trace-collector.ts",
		"obs:report": "npx tsx scripts/trace-report.ts",
		"knip": "npx knip",
		"knip:production": "npx knip --production --include files,dependencies,unlisted,binaries",
		"mock-inventory": "npx tsx scripts/mock-inventory.ts",
		"mock-inventory:check": "npx tsx scripts/mock-inventory.ts --check",
		"demo-fixture-guard:check": "npx tsx scripts/demo-fixture-guard.ts --check",
		"token-guard:check": "npx tsx scripts/token-resolution-guard.ts --check",
		"db:bootstrap:pg": "npx tsx packages/db/src/bootstrap-pg.ts",
		"check:native": "npx tsx packages/desktop/scripts/check-native.ts",
		"eval": "npm run -w @hyperidle/eval eval",
		"eval:quick": "npm run -w @hyperidle/eval eval -- --quick",
		"docs:dev": "vitepress dev docs/product",
		"docs:build": "vitepress build docs/product",
		"smoke:ah6": "tsx --env-file-if-exists=.env scripts/ah6-smoke-local.ts"
	},
	"overrides": {
		"zod-validation-error": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@duckdb/node-api": "^1.5.2-r.1",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/exporter-trace-otlp-http": "^0.216.0",
		"@opentelemetry/resources": "^2.7.1",
		"@opentelemetry/sdk-trace-node": "^2.7.1",
		"@opentelemetry/semantic-conventions": "^1.40.0",
		"@typescript-eslint/parser": "^8.59.0",
		"@typescript-eslint/utils": "^8.59.0",
		"@vitest/coverage-v8": "^4.1.5",
		"concurrently": "^9.1.0",
		"eslint": "^10.2.1",
		"eslint-plugin-design": "*",
		"eslint-plugin-drizzle": "^0.2.3",
		"eslint-plugin-react-compiler": "^19.1.0-rc.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"knip": "^6.13.1",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.34.0",
		"vitepress": "^1.6.4",
		"vitest": "^4.1.5"
	}
}
