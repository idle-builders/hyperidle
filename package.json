{
	"name": "hyperidle",
	"private": true,
	"packageManager": "bun@1.3.13",
	"engines": {
		"node": ">=24.0.0"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "concurrently --names server,web --prefix-colors blue,green \"bun run --filter @hyperidle/server dev\" \"bun run --filter @hyperidle/web dev\"",
		"build": "bun run --filter @hyperidle/web build",
		"start": "HYPERIDLE_STATIC_DIR=packages/web/dist bun run --filter @hyperidle/server start",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"check": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check . && bunx --bun eslint .",
		"lint:biome": "biome check .",
		"lint:eslint": "bunx --bun eslint .",
		"lint:design": "bunx --bun eslint 'packages/web/src/**/*.tsx' 'packages/design-system/src/**/*.tsx'",
		"lint:fix": "biome check --write .",
		"db:generate": "bun run --filter @hyperidle/db generate",
		"db:migrate": "bun run --filter @hyperidle/db migrate",
		"db:migrate:pg": "bun run --filter @hyperidle/db migrate:pg",
		"db:seed:pg": "bun packages/db/src/seed-pg-cli.ts",
		"setup": "bun packages/db/src/setup-cli.ts",
		"test:pg": "bun packages/db/src/pg-test-runner.ts",
		"ds:serve": "bun run --filter @hyperidle/design-system serve",
		"ds:sync": "bun run --filter @hyperidle/design-system sync-check",
		"ds:inspect": "bun packages/design-system/scripts/inspect-page.ts",
		"obs:up": "bun scripts/obs.ts up",
		"obs:down": "bun scripts/obs.ts down",
		"obs:reset": "bun scripts/obs.ts reset",
		"obs:status": "bun scripts/obs.ts status",
		"obs:logs": "bun scripts/obs.ts logs",
		"obs:env": "bun scripts/obs.ts env",
		"obs:smoke": "bun scripts/obs.ts smoke",
		"obs:run": "bun scripts/obs.ts run",
		"obs:collector": "bun scripts/trace-collector.ts",
		"obs:report": "bun scripts/trace-report.ts",
		"pipeline": "bin/pipeline"
	},
	"overrides": {
		"zod-validation-error": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@duckdb/node-api": "^1.5.2-r.1",
		"@eslint/js": "^10.0.1",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/exporter-trace-otlp-http": "^0.216.0",
		"@opentelemetry/resources": "^2.7.1",
		"@opentelemetry/sdk-trace-node": "^2.7.1",
		"@opentelemetry/semantic-conventions": "^1.40.0",
		"@typescript-eslint/parser": "^8.59.0",
		"@vitest/coverage-v8": "^4.1.5",
		"concurrently": "^9.1.0",
		"eslint": "^10.2.1",
		"eslint-plugin-design": "workspace:*",
		"eslint-plugin-drizzle": "^0.2.3",
		"eslint-plugin-react-compiler": "^19.1.0-rc.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.0",
		"vitest": "^4.1.5"
	}
}
