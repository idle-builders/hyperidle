{
	"name": "hyperidle",
	"private": true,
	"workspaces": ["packages/*"],
	"scripts": {
		"dev": "concurrently --names server,web --prefix-colors blue,green \"bun run --filter @hyperidle/server dev\" \"bun run --filter @hyperidle/web dev\"",
		"build": "bun run --filter @hyperidle/web build",
		"start": "HYPERIDLE_STATIC_DIR=packages/web/dist bun run --filter @hyperidle/server start",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"check": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check . && eslint .",
		"lint:biome": "biome check .",
		"lint:eslint": "eslint .",
		"lint:fix": "biome check --write .",
		"db:generate": "bun run --filter @hyperidle/db generate",
		"db:migrate": "bun run --filter @hyperidle/db migrate",
		"db:migrate:pg": "bun run --filter @hyperidle/db migrate:pg",
		"db:seed:pg": "bun packages/db/src/seed-pg-cli.ts",
		"setup": "bun packages/db/src/setup-cli.ts",
		"test:pg": "bun packages/db/src/pg-test-runner.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@eslint/js": "^10.0.1",
		"@typescript-eslint/parser": "^8.58.2",
		"@vitest/coverage-v8": "^3.1.0",
		"concurrently": "^9.1.0",
		"eslint": "^10.2.0",
		"eslint-plugin-drizzle": "^0.2.3",
		"eslint-plugin-react-compiler": "^19.1.0-rc.2",
		"eslint-plugin-react-hooks": "5.2.0",
		"typescript": "^5.7.0",
		"typescript-eslint": "^8.58.2",
		"vitest": "^3.1.0"
	}
}
