{
	"name": "hyperidle",
	"private": true,
	"version": "0.5.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"workspaces": [
		"layers/*",
		"layers/*/*",
		"framework/*",
		"applications/*",
		"tools/*"
	],
	"scripts": {
		"dev": "concurrently --names server,web --prefix-colors blue,green \"npm run -w @hyperidle/remote-server dev\" \"npm run -w @hyperidle/core-ui dev\"",
		"dev:desktop": "concurrently --names web,desktop --prefix-colors green,blue \"npm run -w @hyperidle/core-ui dev\" \"npm run -w @hyperidle/desktop dev\"",
		"build": "npm run -w @hyperidle/core-ui build",
		"build:desktop": "npm run -w @hyperidle/core-ui build && npm run -w @hyperidle/desktop build",
		"build:desktop:local": "bash applications/desktop/__scripts__/build-local.sh",
		"start": "HYPERIDLE_STATIC_DIR=layers/core-ui/dist npm run -w @hyperidle/remote-server start",
		"test": "vitest run --changed=origin/main --passWithNoTests",
		"test:full": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:integration:service": "vitest run --config vitest.integration.config.ts --project service",
		"test:integration:harness": "vitest run --config vitest.integration.config.ts --project harness",
		"test:all": "npm run test:full && npm run test:integration",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "npm run -w @hyperidle/core-ui test:e2e",
		"test:e2e:full": "npm run -w @hyperidle/core-ui test:e2e:full",
		"test:e2e:ah1": "npm run -w @hyperidle/core-ui test:e2e:ah1",
		"test:e2e:ah5": "npm run -w @hyperidle/core-ui test:e2e:ah5",
		"test:e2e:ah6": "npm run -w @hyperidle/core-ui test:e2e:ah6",
		"check": "npx tsx scripts/typecheck-gate.ts",
		"governance:new-cells": "npx tsx scripts/governance-new-cells.ts",
		"lint": "biome check . --reporter=summary && npx eslint . --quiet && npx tsx scripts/governance-lint.ts --fixtures && npx tsx scripts/governance-lint.ts",
		"lint:biome": "biome check . --reporter=summary",
		"lint:eslint": "npx eslint . --quiet",
		"lint:governance": "npx tsx scripts/governance-lint.ts",
		"lint:governance:fixtures": "npx tsx scripts/governance-lint.ts --fixtures",
		"lint:design": "npx eslint 'layers/core-ui/src/**/*.tsx' 'framework/design-system/src/**/*.tsx'",
		"lint:fix": "biome check --write .",
		"verify": "npm run check && npm run lint && npm run knip && npm run knip:production && npm run deps:check && npm run mock-inventory:check && npm run build && npm run -w @hyperidle/desktop build && npx tsx scripts/verify-attest.ts",
		"verify:release": "VERIFY_SCOPE=full npm run verify",
		"verify:quick": "npm run check && npm run lint && npm run knip && npm run knip:production && npm run deps:check",
		"db:generate": "npm run -w @hyperidle/db generate",
		"db:migrate": "npm run -w @hyperidle/db migrate",
		"db:seed:pg": "npx tsx framework/db/src/__testing__/seed-pg-cli.ts",
		"setup": "tsx framework/db/src/setup-cli.ts",
		"test:pg": "npx tsx framework/db/src/__testing__/pg-test-runner.ts",
		"ds:inspect": "npx tsx framework/design-system/__scripts__/inspect-page.ts",
		"obs:env": "npx tsx scripts/obs.ts env",
		"obs:smoke": "npx tsx scripts/obs.ts smoke",
		"obs:run": "npx tsx scripts/obs.ts run",
		"obs:collector": "npx tsx scripts/trace-collector.ts",
		"deps:check": "npx tsx scripts/dep-manifest-lint.ts",
		"knip": "npx knip",
		"knip:production": "npx knip --include files && npx knip --production --include files,dependencies,unlisted,binaries --preprocessor ./scripts/knip-production-test-files.mjs",
		"mock-inventory": "npx tsx scripts/mock-inventory.ts",
		"mock-inventory:check": "npx tsx scripts/mock-inventory.ts --check",
		"db:bootstrap:pg": "npx tsx framework/db/src/bootstrap-pg.ts",
		"check:native": "npx tsx applications/desktop/__scripts__/check-native.ts",
		"eval": "npm run -w @hyperidle/eval eval",
		"eval:quick": "npm run -w @hyperidle/eval eval -- --quick",
		"docs:dev": "vitepress dev docs/product",
		"docs:build": "vitepress build docs/product",
		"smoke:ah6": "tsx --env-file-if-exists=.env scripts/ah6-smoke-local.ts"
	},
	"overrides": {
		"zod-validation-error": "^4.0.0",
		"vitest": "^4.1.9"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
		"@opentelemetry/resources": "^2.8.0",
		"@opentelemetry/sdk-trace-node": "^2.8.0",
		"@opentelemetry/semantic-conventions": "^1.40.0",
		"@typescript-eslint/parser": "^8.62.0",
		"@vitest/coverage-v8": "^4.1.9",
		"concurrently": "^10.0.3",
		"eslint": "^10.6.0",
		"eslint-plugin-design": "*",
		"eslint-plugin-drizzle": "^0.2.3",
		"eslint-plugin-react-compiler": "^19.1.0-rc.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"knip": "^6.23.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.0",
		"vitepress": "^1.6.4",
		"vitest": "^4.1.9"
	}
}
