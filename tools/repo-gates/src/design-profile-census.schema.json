{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "AZ16 live semantic profile census",
	"type": "object",
	"required": [
		"schemaVersion",
		"discoveredPackages",
		"scannedFiles",
		"profiles",
		"rawByFamily",
		"foreignByFamily",
		"invalidProfileSites"
	],
	"properties": {
		"schemaVersion": { "const": 1 },
		"discoveredPackages": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
		"scannedFiles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
		"profiles": { "type": "object" },
		"rawByFamily": { "type": "object" },
		"foreignByFamily": { "type": "object" },
		"invalidProfileSites": { "type": "array" }
	},
	"additionalProperties": false
}
