#!/usr/bin/env bash
# Pipeline orchestrator. Runs inside the dev container by default so the
# Claude Agent SDK can use --dangerously-skip-permissions. When already in
# the container (HYPERIDLE_DOCKER=1), runs bun directly.
#
# Inside container path: install deps if missing, exec bun on the runner.
# Host path: spawn `docker compose run` against infrastructure/pipeline/,
# translate any localhost OTLP endpoint to host.docker.internal so traces
# from the container reach the local Langfuse stack on the host.
#
# Override the image with HYPERIDLE_PIPELINE_IMAGE; skip docker entirely
# with HYPERIDLE_PIPELINE_LOCAL=1 (you'll then have to approve every
# tool call interactively).

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

if [ "${HYPERIDLE_DOCKER:-}" = "1" ]; then
  if [ ! -d node_modules/@anthropic-ai ]; then
    echo "→ Installing repo deps inside container (one-time)…" >&2
    bun install
  fi
  exec bun packages/pipeline/src/index.tsx "$@"
fi

if [ "${HYPERIDLE_PIPELINE_LOCAL:-}" = "1" ]; then
  echo "→ HYPERIDLE_PIPELINE_LOCAL=1 — running on host without docker." >&2
  echo "  Permissions will not be bypassed; expect interactive approvals." >&2
  exec bun packages/pipeline/src/index.tsx "$@"
fi

IMAGE="${HYPERIDLE_PIPELINE_IMAGE:-hyperidle-dev}"
COMPOSE_FILE="$REPO_ROOT/infrastructure/pipeline/docker-compose.yml"

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "→ Building $IMAGE (one-time, takes a few minutes)…" >&2
  docker build -t "$IMAGE" "$REPO_ROOT"
fi

# Translate localhost in the OTLP endpoint so the in-container exporter can
# reach the Langfuse stack the host's `obs:up` started.
otel_in="${OTEL_EXPORTER_OTLP_ENDPOINT:-}"
otel_in="${otel_in//localhost/host.docker.internal}"
otel_in="${otel_in//127.0.0.1/host.docker.internal}"

exec docker compose -f "$COMPOSE_FILE" run --rm \
  -e "OTEL_EXPORTER_OTLP_ENDPOINT=$otel_in" \
  pipeline /workspace/bin/pipeline "$@"
