#!/usr/bin/env bash
#
# Heartbeat wrapper for /pipeline.
# Invokes Claude Code with the pipeline skill in a loop.
# Each session self-exits after ~45 minutes or on context degradation.
# This script restarts it with fresh context.
# Progress persists in .claude/pipeline-progress.json.
#
# The script polls .claude/pipeline-heartbeat to know when it's
# safe to kill Claude. It only kills between stories (when "idle"),
# never mid-work (when "busy").
#
# Uses --permission-mode auto — Claude's AI classifier approves/denies
# tool calls automatically. Safe for local development.
#
# Usage:
#   bin/pipeline              # defaults to "all"
#   bin/pipeline "A1 A2 A3"   # specific stories
#   bin/pipeline "A"           # specific track

set -euo pipefail

# Ensure we're at the repo root regardless of where the script is called from
cd "$(git rev-parse --show-toplevel)" || exit 1

TARGET="${1:-all}"
PROGRESS_FILE=".claude/pipeline-progress.json"
HEARTBEAT_FILE=".claude/pipeline-heartbeat"
LOG_DIR=".claude/pipeline-logs"
SOFT_TIMEOUT=2700         # 45 min — start checking heartbeat for safe kill
HARD_TIMEOUT=7200         # 2 hr — absolute safety net, kill regardless
COOLDOWN_SECONDS=10       # pause between restarts

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

log() { echo -e "${GREEN}[pipeline]${NC} $(date '+%H:%M:%S') $*"; }
warn() { echo -e "${YELLOW}[pipeline]${NC} $(date '+%H:%M:%S') $*"; }
err() { echo -e "${RED}[pipeline]${NC} $(date '+%H:%M:%S') $*"; }
info() { echo -e "${CYAN}[pipeline]${NC} $(date '+%H:%M:%S') $*"; }

# Track claude PID for cleanup
claude_pid=""

cleanup() {
  if [ -n "${claude_pid:-}" ] && kill -0 "$claude_pid" 2>/dev/null; then
    warn "Caught signal — killing Claude process $claude_pid"
    kill "$claude_pid" 2>/dev/null || true
    wait "$claude_pid" 2>/dev/null || true
  fi
  rm -f "$HEARTBEAT_FILE"
}
trap cleanup EXIT INT TERM

is_idle() {
  if [ ! -f "$HEARTBEAT_FILE" ]; then
    return 0  # no heartbeat file = not started yet = safe
  fi
  local status
  status=$(cat "$HEARTBEAT_FILE" 2>/dev/null || echo "unknown")
  [[ "$status" == idle:* ]]
}

check_progress() {
  if [ ! -f "$PROGRESS_FILE" ]; then
    echo "no_progress"
    return
  fi

  PROGRESS_FILE="$PROGRESS_FILE" python3 -c "
import json, os, sys
try:
    data = json.load(open(os.environ['PROGRESS_FILE']))
    stories = data.get('stories', [])
    if not stories:
        print('no_stories')
        sys.exit(0)
    done = [s for s in stories if s.get('status') == 'done']
    failed = [s for s in stories if s.get('status') == 'failed']
    blocked = [s for s in stories if s.get('status') == 'blocked']
    pending = [s for s in stories if s.get('status') in ('pending', 'in_progress')]
    total = len(stories)
    stuck = failed + blocked
    if not pending and not stuck:
        print(f'done:{len(done)}/{total}')
    elif not pending and stuck:
        ids = ', '.join(s['id'] for s in stuck)
        needs_human = [s for s in stuck if s.get('needs_human')]
        human_ids = ', '.join(s['id'] for s in needs_human) if needs_human else 'none'
        print(f'all_blocked:{len(done)}/{total}:blocked:{ids}:needs_human:{human_ids}')
    else:
        if stuck:
            ids = ', '.join(s['id'] for s in stuck)
            print(f'partial_blocked:{len(done)}/{total}:blocked:{ids}')
        else:
            print(f'pending:{len(done)}/{total}')
except Exception as e:
    print(f'error:{e}')
" 2>/dev/null || echo "error"
}

should_stop() {
  local status
  status=$(check_progress)

  case "$status" in
    done:*)
      log "All stories complete! (${status#done:})"
      return 0
      ;;
    all_blocked:*)
      local counts="${status#all_blocked:}"
      local progress="${counts%%:*}"
      local blocked_ids
      blocked_ids=$(echo "$status" | sed 's/.*:blocked:\([^:]*\).*/\1/')
      local human_ids
      human_ids=$(echo "$status" | sed 's/.*:needs_human:\(.*\)/\1/')
      err "Pipeline stalled: all remaining stories blocked. ($progress completed)"
      err "Blocked stories: $blocked_ids"
      if [ "$human_ids" != "none" ]; then
        echo ""
        err "HUMAN INPUT REQUIRED for: $human_ids"
        err "Review .claude/pipeline-progress.json for details on what's needed."
        err "To unblock: fix the issue, set story status to 'pending', restart pipeline."
      fi
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

show_progress() {
  local status
  status=$(check_progress)

  case "$status" in
    pending:*|done:*)
      local progress="${status#*:}"
      progress="${progress%%:*}"
      info "Progress: $progress stories complete"
      ;;
    partial_blocked:*)
      local counts="${status#partial_blocked:}"
      local progress="${counts%%:*}"
      local blocked_ids
      blocked_ids=$(echo "$status" | sed 's/.*:blocked:\(.*\)/\1/')
      info "Progress: $progress stories complete (blocked: $blocked_ids — continuing independent work)"
      ;;
    all_blocked:*)
      local counts="${status#all_blocked:}"
      local progress="${counts%%:*}"
      info "Progress: $progress stories complete (all remaining blocked — needs human input)"
      ;;
    error:*|error)
      err "Failed to read progress file: $status"
      ;;
    no_progress|no_stories)
      info "No progress yet (first run)"
      ;;
  esac
}

run_session() {
  local session_num=$1
  local log_file="$LOG_DIR/session-${session_num}.log"

  log "Starting session #$session_num"
  info "  Target: $TARGET"
  info "  Log: $log_file"
  info "  Permission mode: auto"
  info "  Skill self-exits at ~45min. Safe-kill polling starts at ${SOFT_TIMEOUT}s."
  echo ""

  # Clear heartbeat for fresh start
  echo "idle:$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$HEARTBEAT_FILE"

  # Launch claude in background so we can monitor
  # --permission-mode auto: AI classifier approves/denies tool calls.
  # Safe for local dev — blocks destructive ops, allows in-project edits.
  claude -p --permission-mode auto "/pipeline $TARGET" \
    > "$log_file" 2>&1 &
  claude_pid=$!
  local start_time=$SECONDS
  local last_log=$SECONDS

  # Monitor loop
  while kill -0 "$claude_pid" 2>/dev/null; do
    local elapsed=$(( SECONDS - start_time ))

    # Hard timeout — kill regardless (something is very wrong)
    if [ $elapsed -ge $HARD_TIMEOUT ]; then
      err "Hard timeout (${HARD_TIMEOUT}s). Killing session."
      kill "$claude_pid" 2>/dev/null || true
      wait "$claude_pid" 2>/dev/null || true
      claude_pid=""
      return
    fi

    # Soft timeout — kill only when idle (between stories)
    if [ $elapsed -ge $SOFT_TIMEOUT ]; then
      if is_idle; then
        warn "Soft timeout (${SOFT_TIMEOUT}s) + idle. Ending session for fresh context."
        kill "$claude_pid" 2>/dev/null || true
        wait "$claude_pid" 2>/dev/null || true
        claude_pid=""
        return
      fi
      # Busy — log roughly every minute
      if (( SECONDS - last_log >= 60 )); then
        last_log=$SECONDS
        local busy_story
        busy_story=$(cat "$HEARTBEAT_FILE" 2>/dev/null || echo "unknown")
        info "Past soft timeout but agent is $busy_story — waiting for idle..."
      fi
    fi

    sleep 5
  done

  # Claude exited on its own
  wait "$claude_pid" 2>/dev/null || true
  claude_pid=""
  log "Session ended on its own."
}

# Main
log "═══════════════════════════════════════"
log "  HyperIdle Development Pipeline"
log "═══════════════════════════════════════"
log "Target: $TARGET"
log "Progress: $PROGRESS_FILE"
log "Heartbeat: $HEARTBEAT_FILE"
log "Logs: $LOG_DIR/"
log "Permission: auto (AI classifier)"
log "Soft timeout: ${SOFT_TIMEOUT}s (kills when idle)"
log "Hard timeout: ${HARD_TIMEOUT}s (kills regardless)"
log ""
log "Each session gets fresh Claude context."
log "Progress persists between sessions."
log "Press Ctrl+C to stop between sessions."
log "═══════════════════════════════════════"
echo ""

# Ensure log directory exists
mkdir -p "$LOG_DIR"

iteration=0
while true; do
  iteration=$((iteration + 1))

  # Check if done before starting a session
  if should_stop; then
    break
  fi

  show_progress

  # Run session
  run_session "$iteration"

  # Check if done after session
  if should_stop; then
    break
  fi

  # Cooldown
  log "Restarting in ${COOLDOWN_SECONDS}s (Ctrl+C to stop)..."
  sleep "$COOLDOWN_SECONDS"
done

echo ""
log "═══════════════════════════════════════"
log "  Pipeline finished after $iteration session(s)"
show_progress
log "  Session logs: $LOG_DIR/"
log "═══════════════════════════════════════"
