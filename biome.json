{
	"$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
	"files": {
		"includes": ["**", "!tools/trace/graph.json"]
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"javascript": {
		"globals": ["React", "JSX", "jest"]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"useExhaustiveDependencies": "error",
				"useHookAtTopLevel": "error",
				"noUndeclaredVariables": "error",
				"noConstantCondition": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noConsole": "error",
				"noArrayIndexKey": "warn",
				"noImplicitAnyLet": "error",
				"noDoubleEquals": "error",
				"noFallthroughSwitchClause": "error",
				"noRedeclare": "error",
				"noShadowRestrictedNames": "error",
				"noEmptyBlockStatements": "warn",
				"noMisleadingCharacterClass": "error",
				"useAwait": "warn",
				"useIsArray": "error",
				"noAssignInExpressions": "error",
				"noUnknownAtRules": "warn",
				"useIterableCallbackReturn": "warn"
			},
			"performance": {
				"noDynamicNamespaceImportAccess": "warn"
			},
			"complexity": {
				"noUselessTypeConstraint": "error",
				"noBannedTypes": "error",
				"noExcessiveCognitiveComplexity": {
					"level": "warn",
					"options": {
						"maxAllowedComplexity": 25
					}
				},
				"noForEach": "warn",
				"useFlatMap": "error",
				"useSimplifiedLogicExpression": "warn",
				"useNumericLiterals": "error"
			},
			"style": {
				"noNonNullAssertion": "error",
				"useConst": "error",
				"useImportType": "error",
				"useExportType": "error",
				"noParameterAssign": "error",
				"useNamingConvention": {
					"level": "warn",
					"options": {
						"strictCase": false,
						"conventions": [
							{
								"selector": {
									"kind": "function"
								},
								"formats": ["camelCase", "PascalCase"]
							},
							{
								"selector": {
									"kind": "typeLike"
								},
								"formats": ["PascalCase"]
							},
							{
								"selector": {
									"kind": "objectLiteralProperty"
								},
								"formats": ["camelCase", "snake_case", "CONSTANT_CASE"]
							},
							{
								"selector": {
									"kind": "enumMember"
								},
								"formats": ["CONSTANT_CASE", "PascalCase"]
							},
							{
								"selector": {
									"kind": "variable"
								},
								"formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
							}
						]
					}
				},
				"useCollapsedElseIf": "error",
				"useShorthandAssign": "error",
				"useTemplate": "error",
				"noUselessElse": "error",
				"useExponentiationOperator": "error",
				"useNumberNamespace": "error",
				"useConsistentCurlyBraces": "error",
				"noDescendingSpecificity": "warn"
			},
			"security": {
				"noDangerouslySetInnerHtml": "error",
				"noDangerouslySetInnerHtmlWithChildren": "error",
				"noGlobalEval": "error"
			},
			"a11y": {
				"noAriaUnsupportedElements": "error",
				"noNoninteractiveElementToInteractiveRole": "warn",
				"noRedundantAlt": "error",
				"useAltText": "error",
				"useAnchorContent": "error",
				"useAriaActivedescendantWithTabindex": "error",
				"useAriaPropsForRole": "error",
				"useButtonType": "error",
				"useHeadingContent": "error",
				"useKeyWithClickEvents": "error",
				"useValidAnchor": "error",
				"useValidAriaRole": "error",
				"useAriaPropsSupportedByRole": "warn",
				"noStaticElementInteractions": "warn",
				"useSemanticElements": "warn"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/.astro",
			"!**/*.astro",
			"!**/*.db",
			"!**/coverage",
			"!**/playwright-report",
			"!**/playwright-report-ah1",
			"!**/playwright-report-ah5",
			"!**/playwright-report-ah6",
			"!**/test-results",
			"!**/visual-reports",
			"!**/sync-reports",
			"!.claude/agents",
			"!.claude/package.json",
			"!.claude/process",
			"!.claude/references",
			"!.claude/rules",
			"!.claude/skills",
			"!.claude/settings.json",
			"!.claude/settings.local.json",
			"!.worktrees",
			"!.claude/worktrees",
			"!.pipeline",
			"!**/plans",
			"!tools/eslint-plugin-design/test-fixtures",
			"!layers/agent-execution/harness-registry/src/__tests__/fixtures",
			"!.verify-attestations",
			"!applications/desktop/release",
			"!layers/core-ui/src/index.css",
			"!framework/design-system/viewer/viewer.css",
			"!framework/design-system/*.html",
			"!framework/design-system/html",
			"!framework/design-system/viewer/*.js",
			"!framework/design-system/viewer/*.d.ts",
			"!framework/design-system/viewer/*.map",
			"!framework/design-system/viewer/**/*.js",
			"!framework/design-system/viewer/**/*.d.ts",
			"!framework/design-system/viewer/**/*.map",
			"!docs/product/.vitepress/cache",
			"!docs/product/.vitepress/dist",
			"!.vitepress/cache",
			"!.annotations",
			"!tools/eval/eval-results.json",
			"!tools/eval/*.json",
			"!eval-results.json",
			"!eval-results-*.json"
		]
	},
	"overrides": [
		{
			"includes": ["knip.json"],
			"json": { "parser": { "allowComments": true } }
		},
		{
			"includes": ["**/logger.ts", "**/logger.test.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/*.test.ts",
				"**/*.test.tsx",
				"**/*.spec.ts",
				"**/*.spec.tsx",
				"**/*.stories.tsx",
				"**/test-fixtures.ts"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noEmptyPattern": "off"
					},
					"suspicious": {
						"noEmptyBlockStatements": "off",
						"useAwait": "off"
					},
					"style": {
						"noNonNullAssertion": "off"
					}
				}
			}
		},
		{
			"includes": ["**/__scripts__/**", "tools/governance/src/*.ts", "tools/trace/*.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off",
						"noEmptyBlockStatements": "off"
					}
				}
			}
		},
		{
			"includes": ["tools/trace/*.ts"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveCognitiveComplexity": "off"
					}
				}
			}
		}
	]
}
