{
	"$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"javascript": {
		"globals": ["React", "JSX", "jest"]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"useExhaustiveDependencies": "error",
				"useHookAtTopLevel": "error",
				"noUndeclaredVariables": "error",
				"noConstantCondition": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noConsole": "error",
				"noArrayIndexKey": "error",
				"noImplicitAnyLet": "error",
				"noDoubleEquals": "error",
				"noFallthroughSwitchClause": "error",
				"noRedeclare": "error",
				"noShadowRestrictedNames": "error",
				"noEmptyBlockStatements": "error",
				"noMisleadingCharacterClass": "error",
				"useAwait": "error",
				"useIsArray": "error",
				"noAssignInExpressions": "error",
				"noUnknownAtRules": "error",
				"useIterableCallbackReturn": "error",
				"noTemplateCurlyInString": "off"
			},
			"performance": {
				"noDynamicNamespaceImportAccess": "error"
			},
			"complexity": {
				"noUselessTypeConstraint": "error",
				"noBannedTypes": "error",
				"noForEach": "error",
				"useFlatMap": "error",
				"useSimplifiedLogicExpression": "error",
				"useNumericLiterals": "error"
			},
			"style": {
				"noNonNullAssertion": "error",
				"useConst": "error",
				"useImportType": "error",
				"useExportType": "error",
				"noParameterAssign": "error",
				"useNamingConvention": {
					"level": "error",
					"options": {
						"strictCase": false,
						"conventions": [
							{
								"selector": {
									"kind": "function"
								},
								"formats": ["camelCase", "PascalCase"]
							},
							{
								"selector": {
									"kind": "typeLike"
								},
								"formats": ["PascalCase"]
							},
							{
								"selector": {
									"kind": "objectLiteralMember"
								},
								"formats": ["camelCase", "snake_case", "CONSTANT_CASE", "PascalCase"],
								"match": "[:$]?_*(.+?)_*"
							},
							{
								"selector": {
									"kind": "typeProperty"
								},
								"formats": ["camelCase", "snake_case", "CONSTANT_CASE", "PascalCase"],
								"match": "[:$]?_*(.+?)_*"
							},
							{
								"selector": {
									"kind": "typeMethod"
								},
								"formats": ["camelCase"],
								"match": "[:$]?_*(.+?)_*"
							},
							{
								"selector": {
									"kind": "enumMember"
								},
								"formats": ["CONSTANT_CASE", "PascalCase"]
							},
							{
								"selector": {
									"kind": "variable"
								},
								"formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
							}
						]
					}
				},
				"useCollapsedElseIf": "error",
				"useShorthandAssign": "error",
				"useTemplate": "error",
				"noUselessElse": "error",
				"useExponentiationOperator": "error",
				"useNumberNamespace": "error",
				"useConsistentCurlyBraces": "error",
				"noDescendingSpecificity": "error"
			},
			"security": {
				"noDangerouslySetInnerHtml": "error",
				"noDangerouslySetInnerHtmlWithChildren": "error",
				"noGlobalEval": "error"
			},
			"a11y": {
				"noAriaUnsupportedElements": "error",
				"noNoninteractiveElementToInteractiveRole": "error",
				"noRedundantAlt": "error",
				"useAltText": "error",
				"useAnchorContent": "error",
				"useAriaActivedescendantWithTabindex": "error",
				"useAriaPropsForRole": "error",
				"useButtonType": "error",
				"useHeadingContent": "error",
				"useKeyWithClickEvents": "error",
				"useValidAnchor": "error",
				"useValidAriaRole": "error",
				"useAriaPropsSupportedByRole": "error",
				"noStaticElementInteractions": "error",
				"useSemanticElements": "error"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/.astro",
			"!**/*.astro",
			"!**/*.db",
			"!tools/trace/graph.json",
			"!**/coverage",
			"!**/playwright-report",
			"!**/playwright-report-ah1",
			"!**/playwright-report-ah6",
			"!**/test-results",
			"!**/visual-reports",
			"!**/sync-reports",
			"!.claude/agents",
			"!.claude/package.json",
			"!.claude/process",
			"!.claude/references",
			"!.claude/rules",
			"!.claude/skills",
			"!.hermes",
			"!.claude/settings.json",
			"!.claude/settings.local.json",
			"!.worktrees",
			"!.claude/worktrees",
			"!.pipeline",
			"!viewer",
			"!tools/repo-gates/mock-inventory",
			"!tools/eslint-plugin-design/test-fixtures",
			"!layers/agent-execution/harness-registry/src/__tests__/fixtures",
			"!.verify-attestations",
			"!applications/desktop/release",
			"!docs/product/.vitepress/cache",
			"!docs/product/.vitepress/dist",
			"!.vitepress/cache",
			"!.annotations",
			"!tools/eval/eval-results.json",
			"!tools/eval/*.json",
			"!eval-results.json",
			"!eval-results-*.json"
		]
	},
	"css": { "parser": { "tailwindDirectives": true } },
	"overrides": [
		{
			"includes": ["knip.json"],
			"json": { "parser": { "allowComments": true } }
		},
		{
			"includes": ["**/logger.ts", "**/logger.test.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/*.test.ts",
				"**/*.test.tsx",
				"**/*.spec.ts",
				"**/*.spec.tsx",
				"**/*.stories.tsx",
				"**/test-fixtures.ts"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noEmptyPattern": "off"
					},
					"suspicious": {
						"noEmptyBlockStatements": "off",
						"useAwait": "off"
					},
					"style": {
						"noNonNullAssertion": "off"
					}
				}
			}
		},
		{
			"includes": ["**/__scripts__/**", "tools/governance/src/*.ts", "tools/trace/*.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off",
						"noEmptyBlockStatements": "off"
					}
				}
			}
		}
	]
}
