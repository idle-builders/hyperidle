{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"exactOptionalPropertyTypes": false,
		"composite": true,
		"paths": {
			"@hyperidle/shared": ["./packages/shared/src"],
			"@hyperidle/db": ["./packages/db/src"],
			"@hyperidle/server": ["./packages/server/src"],
			"@hyperidle/core-app": ["./packages/core-app/src"],
			"@hyperidle/agent-layer": ["./packages/agent-layer/src"],
			"@hyperidle/agent-layer/routines": ["./packages/agent-layer/src/routines.ts"],
			"@hyperidle/web": ["./packages/web/src"],
			"@hyperidle/design-system": ["./packages/design-system/src"],
			"@hyperidle/api-contract": ["./packages/api-contract/src"],
			"@hyperidle/desktop": ["./packages/desktop/src"],
			"@hyperidle/eval": ["./packages/eval/src"]
		}
	},
	"references": [
		{ "path": "packages/shared" },
		{ "path": "packages/db" },
		{ "path": "packages/core-app" },
		{ "path": "packages/agent-layer" },
		{ "path": "packages/server" },
		{ "path": "packages/design-system" },
		{ "path": "packages/eslint-plugin-design" },
		{ "path": "packages/eslint-plugin-authz" },
		{ "path": "packages/api-contract" },
		{ "path": "packages/desktop" },
		{ "path": "packages/eval" }
	],
	"include": [],
	"exclude": ["node_modules", "dist"]
}
