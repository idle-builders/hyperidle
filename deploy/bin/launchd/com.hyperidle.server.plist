<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hyperidle.server</string>

	<key>ProgramArguments</key>
	<array>
		<string>__NODE_PATH__</string>
		<string>--import</string>
		<string>tsx</string>
		<string>__REPO_DIR__/packages/server/src/index.ts</string>
	</array>

	<key>WorkingDirectory</key>
	<string>__REPO_DIR__</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>HYPERIDLE_API_KEY</key>
		<string>__API_KEY__</string>
		<key>HYPERIDLE_STATIC_DIR</key>
		<string>__REPO_DIR__/layers/core-ui/dist</string>
		<key>PATH</key>
		<string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>

	<key>StandardOutPath</key>
	<string>__REPO_DIR__/logs/server.log</string>

	<key>StandardErrorPath</key>
	<string>__REPO_DIR__/logs/server.err</string>

	<key>ThrottleInterval</key>
	<integer>5</integer>
</dict>
</plist>
