#!/usr/bin/env bash
set -euo pipefail

# HyperIdle service manager — install/uninstall/start/stop/status/logs
# Runs the production server as a macOS LaunchAgent (survives terminal close + login).

REPO_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
PLIST_TEMPLATE="$REPO_DIR/deploy/bin/launchd/com.hyperidle.server.plist"
PLIST_NAME="com.hyperidle.server"
PLIST_DEST="$HOME/Library/LaunchAgents/$PLIST_NAME.plist"
LOG_DIR="$REPO_DIR/logs"

die() { echo "error: $1" >&2; exit 1; }

ensure_built() {
	if [ ! -f "$REPO_DIR/layers/web/dist/index.html" ]; then
		echo "Building frontend..."
		(cd "$REPO_DIR" && npm run build)
	fi
}

cmd_install() {
	# Check for API key
	local api_key="${HYPERIDLE_API_KEY:-}"
	if [ -z "$api_key" ]; then
		echo "Set HYPERIDLE_API_KEY first:"
		echo "  export HYPERIDLE_API_KEY=your-key-here"
		echo "  deploy/bin/service install"
		exit 1
	fi

	# Find node
	local node_path
	node_path="$(command -v node)" || die "node not found in PATH"

	# Build frontend if needed
	ensure_built

	# Create log directory
	mkdir -p "$LOG_DIR"

	# Generate plist from template
	sed \
		-e "s|__NODE_PATH__|$node_path|g" \
		-e "s|__REPO_DIR__|$REPO_DIR|g" \
		-e "s|__API_KEY__|$api_key|g" \
		"$PLIST_TEMPLATE" > "$PLIST_DEST"

	# Load the service
	launchctl load "$PLIST_DEST" 2>/dev/null || true
	launchctl start "$PLIST_NAME" 2>/dev/null || true

	echo "HyperIdle installed and started."
	echo "  Server:  http://localhost:3001"
	echo "  App:     http://localhost:3001"
	echo "  Logs:    $LOG_DIR/server.log"
	echo ""
	echo "The server will start automatically on login."
	echo "Use 'deploy/bin/service stop' to stop, 'deploy/bin/service uninstall' to remove."
}

cmd_uninstall() {
	if [ -f "$PLIST_DEST" ]; then
		launchctl unload "$PLIST_DEST" 2>/dev/null || true
		rm -f "$PLIST_DEST"
		echo "HyperIdle service uninstalled."
	else
		echo "Service is not installed."
	fi
}

cmd_start() {
	if [ ! -f "$PLIST_DEST" ]; then
		die "Service not installed. Run 'deploy/bin/service install' first."
	fi
	ensure_built
	launchctl start "$PLIST_NAME"
	echo "HyperIdle started."
}

cmd_stop() {
	launchctl stop "$PLIST_NAME" 2>/dev/null || true
	echo "HyperIdle stopped."
}

cmd_restart() {
	cmd_stop
	sleep 1
	ensure_built
	cmd_start
}

cmd_status() {
	if launchctl list "$PLIST_NAME" &>/dev/null; then
		local pid
		pid=$(launchctl list "$PLIST_NAME" 2>/dev/null | awk 'NR==2{print $1}')
		if [ "$pid" != "-" ] && [ -n "$pid" ]; then
			echo "HyperIdle is running (PID $pid)"
			echo "  Server:  http://localhost:3001"
			echo "  Logs:    $LOG_DIR/server.log"
		else
			echo "HyperIdle is installed but not running."
		fi
	else
		echo "HyperIdle is not installed."
	fi
}

cmd_logs() {
	if [ -f "$LOG_DIR/server.log" ]; then
		tail -f "$LOG_DIR/server.log"
	else
		echo "No logs yet. Is the service running?"
	fi
}

cmd_rebuild() {
	echo "Rebuilding frontend..."
	(cd "$REPO_DIR" && npm run build)
	echo "Done. Run 'deploy/bin/service restart' to pick up the new build."
}

case "${1:-help}" in
	install)   cmd_install ;;
	uninstall) cmd_uninstall ;;
	start)     cmd_start ;;
	stop)      cmd_stop ;;
	restart)   cmd_restart ;;
	status)    cmd_status ;;
	logs)      cmd_logs ;;
	rebuild)   cmd_rebuild ;;
	help|*)
		echo "Usage: deploy/bin/service <command>"
		echo ""
		echo "Commands:"
		echo "  install     Build frontend, install launchd service, start server"
		echo "  uninstall   Stop and remove the launchd service"
		echo "  start       Start the server"
		echo "  stop        Stop the server"
		echo "  restart     Stop, rebuild if needed, start"
		echo "  status      Show whether the server is running"
		echo "  logs        Tail the server log"
		echo "  rebuild     Rebuild the frontend (run restart after)"
		;;
esac
