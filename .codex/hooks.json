{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/guard-main.sh\"",
						"timeout": 5,
						"statusMessage": "Checking branch safety"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/log-bash.sh\"",
						"timeout": 5,
						"statusMessage": "Recording Bash audit"
					}
				]
			}
		]
	}
}
