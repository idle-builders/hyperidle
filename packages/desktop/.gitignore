# Built artifacts — generated by scripts/bundle.ts
dist/

# Packaged app artifacts — generated by electron-builder
release/

# Generated in CI only for electron-rebuild; not committed to the repo.
# @lore N5: npm install --package-lock-only generates this from package.json
# so electron-rebuild can resolve better-sqlite3's native module version.
# bun uses bun.lockb, not package-lock.json. The lock file is a CI artifact
# only — committing it would create a dual-lockfile conflict.
package-lock.json
