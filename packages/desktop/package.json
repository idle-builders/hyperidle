{
	"name": "@hyperidle/desktop",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "src/main.ts",
	"scripts": {
		"dev": "bun scripts/check-native.ts && NODE_OPTIONS='--import tsx' electron .",
		"build": "bun scripts/bundle.ts",
		"build:dist": "electron-builder --config electron-builder.yml",
		"check:native": "bun scripts/check-native.ts",
		"check": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@hyperidle/db": "workspace:*",
		"@hyperidle/server": "workspace:*",
		"better-sqlite3": "^12.9.0"
	},
	"devDependencies": {
		"esbuild": "^0.25.0",
		"vitest": "*"
	},
	"optionalDependencies": {
		"@electron/rebuild": "^4.0.4",
		"electron": "^36.0.0"
	}
}
