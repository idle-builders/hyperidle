{
	"name": "@hyperidle/desktop",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"main": "src/main.ts",
	"scripts": {
		"dev": "npx tsx scripts/check-native.ts && NODE_OPTIONS='--import tsx' electron .",
		"build": "npx tsx scripts/bundle.ts",
		"build:dist": "electron-builder --config electron-builder.yml",
		"build:local": "bash scripts/build-local.sh",
		"check:native": "npx tsx scripts/check-native.ts",
		"check": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@hyperidle/server": "*",
		"@hyperidle/shared": "*",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@hyperidle/db": "*",
		"electron": "36.9.5",
		"esbuild": "^0.25.0",
		"vitest": "*"
	}
}
