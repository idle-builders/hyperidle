{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": ".",
		"composite": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"types": ["node"],
		"jsx": "react-jsx",
		"jsxImportSource": "react"
	},
	"include": ["src/**/*.ts", "test-fixtures/**/*.tsx"]
}
