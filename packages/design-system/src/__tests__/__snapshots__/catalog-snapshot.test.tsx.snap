  <div class="flex items-center gap-[12px] px-[24px] py-[12px] border-b border-[var(--border-subtle)] last:border-b-0 hover:bg-[color-mix(in_oklab,var(--text-secondary)_2%,transparent)] transition-colors duration-[var(--motion-default)] focus-visible:outline focus-visible:outline-1 focus-visible:outline-[var(--accent-primary)] focus-visible:-outline-offset-1" data-ds-component="ThreadRow" data-ds-source="design-system" data-ds-tier="2">
    <span class="w-[8px] h-[8px] rounded-full shrink-0 bg-transparent" aria-hidden="true" />
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-[12px]">
        <span class="text-[15px] truncate font-[400]" aria-label="Thread: Idle agent — no active session">
          "Idle agent — no active session"
        </span>
      </div>
      <p class="text-[13px] truncate mt-[1px] text-[var(--text-tertiary)]">
        "Scout is available but not currently running"
      </p>
    </div>
    <div class="flex items-center gap-[9px] shrink-0">
      <div class="flex">
        <span class="relative w-[24px] h-[24px] rounded-full inline-flex items-center justify-center shrink-0 text-[9px] font-[600] leading-none border-[2px] border-[var(--surface-elevated)]  bg-[var(--accent-primary-dim)] border-[var(--accent-primary)] text-[var(--accent-primary)]">
          "SC"
        </span>
      </div>
      <span class="inline-flex items-center justify-center text-[12px] font-[500] px-[6px] py-[3px] rounded-[var(--r-pill)] min-w-[20px] text-center whitespace-nowrap bg-[var(--surface-container)] text-[var(--text-secondary)]">
        "2"
      </span>
      <span class="text-[12px] text-[var(--text-tertiary)] whitespace-nowrap">
        "1h ago"
      </span>
    </div>
  </div>
</div>
