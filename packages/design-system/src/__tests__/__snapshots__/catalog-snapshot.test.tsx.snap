exports[`Checkbox > Default 1`] = `
"<div class="p-[18px] flex flex-col gap-[12px]">
  <label class="flex items-center gap-[9px] cursor-pointer " data-ds-component="Checkbox" data-ds-source="design-system" data-ds-tier="0" for="checkbox-accept-terms-and-conditions">
    <div class="relative shrink-0">
      <input class="sr-only" type="checkbox" id="checkbox-accept-terms-and-conditions" />
      <div class="h-[20px] w-[20px] rounded-[6px] border-[1.5px] transition-all duration-[var(--motion-fast)] ease-[var(--motion-ease)] flex items-center justify-center bg-[var(--surface-elevated)] border-[var(--border-default)]" aria-hidden="true" />
    </div>
    <span class="text-[13px] text-[var(--text-primary)]">
      "Accept terms and conditions"
    </span>
  </label>
  <label class="flex items-center gap-[9px] cursor-pointer " data-ds-component="Checkbox" data-ds-source="design-system" data-ds-tier="0" for="checkbox-send-me-marketing-emails">
    <div class="relative shrink-0">
      <input class="sr-only" type="checkbox" id="checkbox-send-me-marketing-emails" checked="" />
      <div class="h-[20px] w-[20px] rounded-[6px] border-[1.5px] transition-all duration-[var(--motion-fast)] ease-[var(--motion-ease)] flex items-center justify-center bg-[var(--accent-primary)] border-[var(--accent-primary)]" aria-hidden="true">
        <span class="block h-[10px] w-[6px] border-b-[2px] border-r-[2px] border-white rotate-45 translate-y-[-1px]" />
      </div>
    </div>
    <span class="text-[13px] text-[var(--text-primary)]">
      "Send me marketing emails"
    </span>
  </label>
  <label class="flex items-center gap-[9px] cursor-pointer opacity-50 cursor-not-allowed" data-ds-component="Checkbox" data-ds-source="design-system" data-ds-tier="0" for="checkbox-disabled-unchecked">
    <div class="relative shrink-0">
      <input class="sr-only" type="checkbox" id="checkbox-disabled-unchecked" disabled="" />
      <div class="h-[20px] w-[20px] rounded-[6px] border-[1.5px] transition-all duration-[var(--motion-fast)] ease-[var(--motion-ease)] flex items-center justify-center bg-[var(--surface-elevated)] border-[var(--border-default)]" aria-hidden="true" />
    </div>
    <span class="text-[13px] text-[var(--text-primary)]">
      "Disabled unchecked"
    </span>
  </label>
  <label class="flex items-center gap-[9px] cursor-pointer opacity-50 cursor-not-allowed" data-ds-component="Checkbox" data-ds-source="design-system" data-ds-tier="0" for="checkbox-disabled-checked">
    <div class="relative shrink-0">
      <input class="sr-only" type="checkbox" id="checkbox-disabled-checked" checked="" disabled="" />
      <div class="h-[20px] w-[20px] rounded-[6px] border-[1.5px] transition-all duration-[var(--motion-fast)] ease-[var(--motion-ease)] flex items-center justify-center bg-[var(--accent-primary)] border-[var(--accent-primary)]" aria-hidden="true">
        <span class="block h-[10px] w-[6px] border-b-[2px] border-r-[2px] border-white rotate-45 translate-y-[-1px]" />
      </div>
    </div>
    <span class="text-[13px] text-[var(--text-primary)]">
      "Disabled checked"
    </span>
  </label>
</div>
"
`;

