    <div style="display: flex; gap: var(--space-2);">
      <button style="font-size: var(--text-sm); font-weight: var(--fw-medium); color: var(--text-secondary); background: transparent; border: 1px solid var(--border-default); border-radius: var(--r-subtle); padding: var(--space-2) var(--space-4); cursor: pointer;" type="button">
        "Stay"
