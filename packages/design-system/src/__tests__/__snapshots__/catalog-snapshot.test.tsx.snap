      <button style="font-size: var(--text-sm); font-weight: var(--fw-medium); color: var(--status-error); background: transparent; border: 1px solid var(--status-error); border-radius: var(--r-subtle); padding: var(--space-2) var(--space-4); cursor: pointer;" type="button">
        "Leave anyway"
