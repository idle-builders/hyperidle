exports[`AI2/DialogPortalRoot > MountEffect 1`] = `
"<div style="padding: var(--space-6); background: var(--surface-page); border-radius: var(--r-default); max-width: 480px;">
  <p style="font-size: var(--text-sm); color: var(--text-secondary); margin: 0px; line-height: 1.5;">
    <strong style="color: var(--text-primary); display: block; margin-bottom: var(--space-3);">
      "DialogPortalRoot"
    </strong>
    "Zero-visual component. On mount, it calls"
    <code style="font-family: var(--font-mono); font-size: var(--text-xs);">
      "ensureOverlayRoot()"
    </code>
    "to create a"
    <code style="font-family: var(--font-mono); font-size: var(--text-xs);">
      "#overlay-root"
    </code>
    "div as a sibling of"
    <code style="font-family: var(--font-mono); font-size: var(--text-xs);">
      "#root"
    </code>
    "under"
    <code style="font-family: var(--font-mono); font-size: var(--text-xs);">
      "document.body"
    </code>
    ". All Dialog portals target this node."
  </p>
</div>
"
`;

exports[`AI2/DiscardConfirmStrip > CustomCopy 1`] = `
"<div style="padding: var(--space-4) var(--space-6); background: var(--surface-elevated); border-radius: var(--r-default); max-width: 480px;">
  <div style="display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding: var(--space-3) 0; border-top: 1px solid var(--border-subtle); background: color-mix(in srgb, var(--status-warning) 4%, transparent);">
    <span style="font-size: var(--text-sm); color: var(--text-secondary); flex: 1 1 0%;">
      "Unsaved changes will be lost."
