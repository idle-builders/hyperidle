exports[`ArtifactPreviewSurface > CodeFull 1`] = `
"<div class="w-[480px]">
  <div class="bg-[var(--surface-container)] rounded-[var(--r-subtle)] p-[12px] flex items-center justify-center text-[var(--text-tertiary)] font-mono text-[11px] tracking-[var(--tracking-caps-sm)] uppercase min-h-[240px] items-start" data-ds-component="ArtifactPreviewSurface" data-ds-source="design-system" data-ds-tier="1">
    <section aria-label="Code diff">
      <p class="text-xs font-mono text-[var(--text-secondary)] mb-2">
        "src/index.ts"
      </p>
      <pre class="bg-[var(--surface-container)] rounded-[var(--r-default)] p-[12px] overflow-x-auto text-xs font-mono leading-[1.4] m-0">
        <div>
          <div class="text-[var(--text-tertiary)] select-none px-2 py-1">
            "@@ -1,3 +1,4 @@"
          </div>
          <div class="px-2 py-[3px] ">
            <span class="select-none text-[var(--text-tertiary)] mr-2">
            </span>
            <code>
              "import React from 'react';"
            </code>
          </div>
          <div class="px-2 py-[3px] bg-[color-mix(in_oklab,var(--status-success)_10%,transparent)]">
            <span class="select-none text-[var(--text-tertiary)] mr-2">
              "+"
            </span>
            <code>
