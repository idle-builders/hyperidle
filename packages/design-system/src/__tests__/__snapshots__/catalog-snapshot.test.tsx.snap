        <option value="" disabled="">
          "Select one…"
        </option>
        <option value="light">
          "Light"
        </option>
        <option value="dark">
          "Dark"
        </option>
        <option value="system">
          "System"
        </option>
      </select>
      <span class="pointer-events-none absolute right-[12px] top-1/2 -translate-y-1/2 border-l-[5px] border-r-[5px] border-t-[6px] border-l-transparent border-r-transparent border-t-[var(--border-strong)]" aria-hidden="true" />
    </div>
  </div>
</div>
"
`;

