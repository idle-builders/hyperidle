        <span class="relative w-[24px] h-[24px] rounded-full inline-flex items-center justify-center shrink-0 text-[9px] font-[600] leading-none border-[2px] border-[var(--surface-elevated)] ml-[-6px] bg-[var(--surface-page)] border-[var(--border-default)] text-[var(--text-secondary)]">
          "TG"
