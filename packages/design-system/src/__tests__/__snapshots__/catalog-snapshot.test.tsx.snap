  <div class="flex-1 overflow-y-auto">
    <div class="bg-[var(--surface-page)] rounded-[var(--r-default)] p-[36px] max-w-[420px] text-left" data-ds-component="EmptyState" data-ds-source="design-system" data-ds-tier="2" role="status">
      <p class="text-[20px] font-[600] text-[var(--text-primary)] leading-[1.4] tracking-[-0.01em] mb-[9px]">
        "No messages yet"
      </p>
      <p class="text-[15px] text-[var(--text-secondary)] leading-[1.7] mb-[18px]">
        "Be the first to post in this thread."
      </p>
    </div>
  </div>
  <div class="max-w-[720px] mx-auto w-full px-[24px]">
    <div class="flex flex-col gap-[6px] py-[12px] px-[24px] pb-[18px]" data-ds-component="Composer" data-ds-source="design-system" data-ds-tier="2">
      <div class="flex items-stretch gap-[9px]">
        <textarea class="flex-1 min-h-[44px] resize-none bg-[var(--surface-page)] text-[var(--text-primary)] placeholder:text-[var(--text-placeholder)] border-[1.5px] border-[var(--border-default)] rounded-[var(--r-default)] px-[12px] py-[9px] text-[15px] focus:outline-none focus-visible:outline focus-visible:outline-1 focus-visible:outline-[var(--accent-primary)] focus:border-[var(--accent-primary)] focus:shadow-[0_0_0_3px_var(--accent-primary-dim)]" placeholder="Reply to thread…" />
        <button class="px-[12px] min-h-[44px] rounded-[var(--r-pill)] text-[12px] font-[500] bg-[var(--accent-primary)] text-[var(--text-on-accent)] hover:bg-[var(--accent-primary-hover)] active:scale-[0.97] disabled:opacity-50 disabled:cursor-not-allowed focus-visible:outline focus-visible:outline-1 focus-visible:outline-[var(--accent-primary)] self-stretch transition-all duration-[var(--motion-default)]" type="button" disabled="">
          "Send"
        </button>
      </div>
    </div>
  </div>
</div>
"
`;

