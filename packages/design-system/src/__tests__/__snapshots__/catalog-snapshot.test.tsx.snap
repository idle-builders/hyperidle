exports[`BodyEditor > RichContent 1`] = `
"<div class="body-editor" style="min-height: 120px;" data-ds-component="BodyEditor" data-ds-source="design-system" data-ds-tier="2">
  <div>
    <div class="tiptap ProseMirror" role="textbox" tabindex="0">
