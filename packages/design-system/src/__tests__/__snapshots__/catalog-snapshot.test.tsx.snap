        <span class="relative w-[24px] h-[24px] rounded-full inline-flex items-center justify-center shrink-0 text-[9px] font-[600] leading-none border-[2px] border-[var(--surface-elevated)] ml-[-6px] bg-[var(--accent-primary-dim)] border-[var(--accent-primary)] text-[var(--accent-primary)]">
          "AR"
          <span class="absolute bottom-0 right-0 w-[6px] h-[6px] rounded-full border-[1.5px] border-[var(--surface-elevated)] bg-[var(--accent-primary)]" aria-label="AR - active" />
        </span>
      </div>
      <span class="inline-flex items-center justify-center text-[12px] font-[500] px-[6px] py-[3px] rounded-[var(--r-pill)] min-w-[20px] text-center whitespace-nowrap bg-[var(--surface-container)] text-[var(--text-secondary)]">
        "3"
      </span>
      <span class="text-[12px] text-[var(--text-tertiary)] whitespace-nowrap">
        "Just now"
      </span>
    </div>
  </div>
  <div class="flex items-center gap-[12px] px-[24px] py-[12px] border-b border-[var(--border-subtle)] last:border-b-0 hover:bg-[color-mix(in_oklab,var(--text-secondary)_2%,transparent)] transition-colors duration-[var(--motion-default)] focus-visible:outline focus-visible:outline-1 focus-visible:outline-[var(--accent-primary)] focus-visible:-outline-offset-1 border-l-[var(--bw-strong)] border-[var(--status-error)]" data-ds-component="ThreadRow" data-ds-source="design-system" data-ds-tier="2">
    <span class="w-[8px] h-[8px] rounded-full shrink-0 bg-transparent" aria-hidden="true" />
