        <div class="flex flex-1 items-center justify-center rounded-[var(--r-subtle)] border border-dashed border-[var(--border-default)] bg-[var(--surface-container)] text-center text-[13px] text-[var(--text-secondary)]">
          "conversation / review / knowledge"
        </div>
      </div>
    </div>
    <button class="group relative -mx-[var(--space-3)] flex w-[var(--space-3)] shrink-0 cursor-col-resize items-center justify-center bg-transparent transition-colors duration-[var(--motion-fast)] ease-[var(--motion-ease)] focus-visible:outline focus-visible:outline-1 focus-visible:outline-[var(--accent-primary)]" aria-label="Resize panels" type="button">
      <span class="pointer-events-none h-[36px] w-[3px] rounded-[var(--r-pill)] transition-colors duration-[var(--motion-fast)] ease-[var(--motion-ease)] bg-[var(--border-strong)] group-hover:bg-[var(--accent-primary)]" />
    </button>
    <div class="relative flex min-w-0 flex-col overflow-hidden rounded-[var(--r-default)] bg-[var(--surface-elevated)] shadow-[var(--shadow-default)]" style="flex-grow: 1; flex-basis: 50%;">
      <div class="absolute right-[12px] top-[12px] z-10 flex items-center gap-[6px]">
        <button class="inline-flex h-[28px] w-[28px] items-center justify-center rounded-[var(--r-pill)] border border-[var(--border-default)] bg-[color-mix(in_oklab,var(--surface-page)_80%,transparent)] text-[var(--text-secondary)] transition-colors duration-[var(--motion-fast)] ease-[var(--motion-ease)] hover:text-[var(--text-primary)] focus-visible:outline focus-visible:outline-1 focus-visible:outline-[var(--accent-primary)] focus-visible:[outline-offset:1px]" aria-label="Expand to full" type="button" title="Expand to full">
          <svg aria-hidden="true">
            <path />
            <path />
            <path />
            <path />
          </svg>
        </button>
        <button class="inline-flex h-[28px] w-[28px] items-center justify-center rounded-[var(--r-pill)] border border-[var(--border-default)] bg-[color-mix(in_oklab,var(--surface-page)_80%,transparent)] text-[var(--text-secondary)] transition-colors duration-[var(--motion-fast)] ease-[var(--motion-ease)] hover:text-[var(--text-primary)] focus-visible:outline focus-visible:outline-1 focus-visible:outline-[var(--accent-primary)] focus-visible:[outline-offset:1px]" aria-label="Fold back" type="button" title="Fold back">
          <svg aria-hidden="true">
            <path />
            <path />
          </svg>
        </button>
      </div>
      <div class="min-h-0 flex-1 overflow-auto">
        <div class="flex h-full flex-col gap-[6px] p-[18px]">
          <div class="font-mono text-[11px] uppercase tracking-[var(--tracking-caps-sm)] text-[var(--text-tertiary)]">
            "destination — the resolved composition"
          </div>
          <div class="flex flex-1 items-center justify-center rounded-[var(--r-subtle)] border border-dashed border-[var(--border-default)] bg-[var(--surface-container)] text-center text-[13px] text-[var(--text-secondary)]">
            "artifact (single) · review (diff) · body (mixed)"
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
"
`;

