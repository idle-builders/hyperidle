{
	"name": "@hyperidle/design-system",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./tokens.css": "./src/tokens.css"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"test": "vitest run",
		"test:visual": "playwright test --config playwright.config.ts",
		"test:workbench": "playwright test --config playwright.workbench.config.ts",
		"serve": "vite --config vite.config.ts",
		"serve:static": "npx tsx scripts/serve.ts"
	},
	"dependencies": {
		"@hyperidle/fabric": "*",
		"@hyperidle/shared": "*"
	},
	"peerDependencies": {
		"react": "^19.0.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@types/pngjs": "^6.0.5",
		"jsdom": "^29.0.2",
		"@vitejs/plugin-react": "^4.3.0",
		"autoprefixer": "^10.4.0",
		"daisyui": "^4.12.0",
		"pixelmatch": "^7.1.0",
		"pngjs": "^7.0.0",
		"postcss": "^8.4.0",
		"react-dom": "^19.0.0",
		"tailwindcss": "^3.4.0",
		"vite": "^6.0.0"
	}
}
