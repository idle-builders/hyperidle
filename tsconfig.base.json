{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"exactOptionalPropertyTypes": false,
		"composite": true,
		"paths": {
			"@hyperidle/domain-model": ["./framework/domain-model/src"],
			"@hyperidle/diagnostics": ["./framework/diagnostics/src"],
			"@hyperidle/harness-capability": ["./framework/harness-capability/src"],
			"@hyperidle/work-intent-port": ["./framework/work-intent-port/src"],
			"@hyperidle/event-bus": ["./framework/event-bus/src"],
			"@hyperidle/presentation-format": ["./framework/presentation-format/src"],
			"@hyperidle/block-derivation": ["./framework/block-derivation/src"],
			"@hyperidle/conversation-parts": ["./framework/conversation-parts/src"],
			"@hyperidle/cron": ["./framework/cron/src"],
			"@hyperidle/toon-codec": ["./framework/toon-codec/src"],
			"@hyperidle/query-escaping": ["./framework/query-escaping/src"],
			"@hyperidle/factory-defaults": ["./framework/factory-defaults/src"],
			"@hyperidle/host-process": ["./framework/host-process/src"],
			"@hyperidle/http-middleware": ["./framework/http-middleware/src"],
			"@hyperidle/harness-protocol": ["./framework/harness-protocol/src"],
			"@hyperidle/tool-protocol": ["./framework/tool-protocol/src"],
			"@hyperidle/db": ["./framework/db/src"],
			"@hyperidle/core-ui": ["./layers/core-ui/src"],
			"@hyperidle/design-system": ["./framework/design-system/src"],
			"@hyperidle/api-contract": ["./framework/api-contract/src"],
			"@hyperidle/desktop": ["./applications/desktop/src"],
			"@hyperidle/eval": ["./tools/eval/src"]
		}
	}
}
