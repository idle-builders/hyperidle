{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AZ16 migration receipt TSV row",
  "type": "object",
  "required": ["audit_site_id", "audit_destination", "outcome", "profile", "final_path", "final_locator"],
  "properties": {
    "audit_site_id": { "type": "string", "minLength": 1 },
    "audit_destination": { "type": "string", "minLength": 1 },
    "outcome": {
      "enum": ["PROFILE", "NONE", "REMOVE", "SNAP", "GEOMETRY", "FOREIGN", "GLYPH_REPAIR", "HEADING_VARIANT"]
    },
    "profile": { "type": "string" },
    "final_path": { "type": "string", "minLength": 1 },
    "final_locator": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
