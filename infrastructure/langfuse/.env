# Local-only Langfuse secrets. These are bound to a local Docker stack —
# they are NOT real credentials and authenticate only against your machine's
# Langfuse instance. Replace if you ever expose this stack on a network.
#
# The matching SDK-side OTLP env vars live in `otel.env` next door.

LANGFUSE_SALT=hyperidle-local-salt-do-not-use-in-prod
LANGFUSE_ENCRYPTION_KEY=26a06f8ccc28421f1cd1f8283a664371939b9080ad4af31e04dd8dfe31221b14
LANGFUSE_NEXTAUTH_SECRET=hyperidle-local-nextauth-secret
LANGFUSE_INIT_USER_PASSWORD=hyperidle-local-pw

# Bootstrap keypair: the Langfuse stack creates this project + keys on first
# boot. The matching `Authorization: Basic <base64>` header is in otel.env.
LANGFUSE_PROJECT_PUBLIC_KEY=pk-lf-hyperidle-local-pub
LANGFUSE_PROJECT_SECRET_KEY=sk-lf-hyperidle-local-secret
