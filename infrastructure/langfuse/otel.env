# SDK-side OTLP env vars for the local trace collector
# (scripts/trace-collector.ts → DuckDB at .pipeline/traces.duckdb).
# Source this in any terminal session you want traced:
#
#   source <(bun run obs:env)               # for host processes
#   source <(bun run obs:env --in-container) # for processes inside the dev container
#                                             # (rewrites localhost → host.docker.internal)
#
# Or layer A/B tags on top:
#
#   source <(bun run obs:ab block-1 variant)
#
# Then start the collector in another terminal: `bun run obs:collector`
# and read the data with: `bun run obs:report`.

export OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
export OTEL_EXPORTER_OTLP_PROTOCOL="http/json"

export OTEL_RESOURCE_ATTRIBUTES="service.name=hyperidle-pipeline,deployment.environment=local"

# Claude Code: ENABLE_TELEMETRY ships metrics + logs by default; traces are
# beta and need the enhanced flag. Our collector accepts only traces, so
# point metrics/logs at the no-op exporter to avoid noise.
export CLAUDE_CODE_ENABLE_TELEMETRY=1
export CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1
export OTEL_TRACES_EXPORTER=otlp
export OTEL_METRICS_EXPORTER=none
export OTEL_LOGS_EXPORTER=none
