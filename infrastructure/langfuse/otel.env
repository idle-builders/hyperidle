# SDK-side OTLP environment variables for the local Langfuse stack.
# `source` this before running `bun pipeline` (or use `bun run obs:run`).
#
#   set -a; source infrastructure/langfuse/otel.env; set +a
#   bun pipeline <storyId>
#
# Auth header is base64("pk-lf-hyperidle-local-pub:sk-lf-hyperidle-local-secret").
# Update if you change LANGFUSE_PROJECT_PUBLIC_KEY/SECRET_KEY in `.env`.

export OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:3000/api/public/otel"
export OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic cGstbGYtaHlwZXJpZGxlLWxvY2FsLXB1Yjpzay1sZi1oeXBlcmlkbGUtbG9jYWwtc2VjcmV0,x-langfuse-ingestion-version=4"
export OTEL_RESOURCE_ATTRIBUTES="service.name=hyperidle-pipeline,deployment.environment=local"
