# SDK-side OTLP env vars for the local Langfuse stack.
# Source this in any terminal session you want traced:
#
#   source <(bun run obs:env)               # for host processes
#   source <(bun run obs:env --in-container) # for processes inside the dev container
#                                             # (rewrites localhost → host.docker.internal)
#
# Or layer A/B tags on top:
#
#   source <(bun run obs:ab block-1 variant)
#
# Auth header is base64("pk-lf-hyperidle-local-pub:sk-lf-hyperidle-local-secret").
# Update if you change LANGFUSE_PROJECT_PUBLIC_KEY/SECRET_KEY in `.env`.

export OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:3000/api/public/otel"
export OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic cGstbGYtaHlwZXJpZGxlLWxvY2FsLXB1Yjpzay1sZi1oeXBlcmlkbGUtbG9jYWwtc2VjcmV0,x-langfuse-ingestion-version=4"
export OTEL_RESOURCE_ATTRIBUTES="service.name=hyperidle-pipeline,deployment.environment=local"

# Claude Code's native OTel emission. Set so an interactive `claude` session
# also produces traces alongside pipeline runs.
export CLAUDE_CODE_ENABLE_TELEMETRY=1
