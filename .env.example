# HyperIdle Environment Variables
#
# SECURITY: This file contains placeholder values for sensitive keys.
# Copy to .env and replace all CHANGE_ME_* placeholders before starting.
# Never commit .env to version control — only .env.example is checked in.

# --- Required ---

# API key for authenticating requests to the HyperIdle server.
# All API calls must include this as X-API-Key header.
# N2: In dev, both HYPERIDLE_API_KEY (server) and VITE_HYPERIDLE_API_KEY (web)
# must hold the SAME value. If they mismatch, every API call returns 401.
# In Electron, both are set automatically from the same generated key.
HYPERIDLE_API_KEY=CHANGE_ME_STRONG_API_KEY
# Dev-only: exposed to the Vite SPA via import.meta.env.VITE_HYPERIDLE_API_KEY
# Must match HYPERIDLE_API_KEY exactly. See layers/core-ui/.env.example for details.
VITE_HYPERIDLE_API_KEY=CHANGE_ME_STRONG_API_KEY

# --- Server ---

# Port for the Hono API server (default: 3001).
PORT=3001

# Database URL. SQLite path for laptop profile, PostgreSQL URL for vps/cloud.
# Examples:
#   SQLite:   ./hyperidle.db
#   Postgres: postgresql://user:pass@localhost:5432/hyperidle
DATABASE_URL=./hyperidle.db

# Deployment profile: laptop | vps | cloud (default: laptop).
HYPERIDLE_PROFILE=laptop

# Node environment: development | production | test.
NODE_ENV=development

# --- Database (PostgreSQL — VPS/Cloud profiles only) ---

# Password for the PostgreSQL database.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PG_PASSWORD

# --- Security ---

# Trust X-Forwarded-For header for client IP resolution (set to "true" behind a reverse proxy).
HYPERIDLE_TRUST_PROXY=false

# Rate limit: max requests per minute per client (default: 60).
HYPERIDLE_RATE_LIMIT_PER_MIN=60

# Max request body size in bytes (default: 1000000 = 1 MiB).
HYPERIDLE_MAX_BODY_BYTES=1000000

# --- WebSocket ---

# WebSocket upgrade token TTL in milliseconds (default: 30000 = 30s).
HYPERIDLE_WS_TOKEN_TTL_MS=30000

# Maximum number of active upgrade tokens (default: 1000).
HYPERIDLE_WS_TOKEN_MAX=1000

# --- Agent Runtime ---

# Set to "1" when running inside Docker (affects workspace adapter behavior).
HYPERIDLE_DOCKER=0

# Enable unsafe agent mode: allows agents access to environment variables.
# WARNING: Only use in development. Never enable in production.
# HYPERIDLE_UNSAFE_AGENT_MODE=false

# Anthropic API key for Claude agent SDK adapter.
# Required only when using the Claude harness adapter.
# ANTHROPIC_API_KEY=

# --- Git Export ---

# Allow file:// protocol for git remotes (development only, never in production).
# HYPERIDLE_GIT_ALLOW_FILE_REMOTE=false
