# HyperIdle — environment template.
# Copy to `.env` and adjust per deployment profile.
# Documented in docs/DEPLOYMENT.md.
#
# SECURITY: Never commit a populated `.env` file or replace the CHANGE_ME_*
# placeholders below with real secrets in this template. `.env` is
# gitignored; keep it local to each host. Generate strong random values
# (e.g. `openssl rand -hex 32`) for passwords and API keys.

# --- Deployment profile ---
# laptop | vps | cloud
HYPERIDLE_PROFILE=laptop

# --- Database (laptop profile uses SQLite; vps/cloud use Postgres) ---
# SQLite (laptop): file path
# HYPERIDLE_SQLITE_PATH=./hyperidle.db

# Postgres (vps/cloud): full connection URL. Override if your cluster is
# external to the compose stack; otherwise leave blank and the compose
# file derives it from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
# DATABASE_URL=postgres://hyperidle:CHANGE_ME_STRONG_PASSWORD@localhost:5432/hyperidle

# Postgres connection-pool size. Default 10. Raise for high-concurrency
# workloads; consult `packages/db/src/pg-connection.ts` for plumbing.
# PG_POOL_SIZE=10

# --- Docker Compose (vps profile) ---
POSTGRES_DB=hyperidle
POSTGRES_USER=hyperidle
# REQUIRED for vps. Replace with a strong random value before bringing up.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Server ---
# PORT=3001

# API key required for server→server calls (H1). Generate with
# `openssl rand -hex 32` — never commit a real value.
# HYPERIDLE_API_KEY=CHANGE_ME_STRONG_RANDOM_KEY

# --- Observability (H3) ---
# HYPERIDLE_OBSERVABILITY=console
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=

# --- Notifications (H2) ---
# HYPERIDLE_NOTIFICATIONS=console
# NTFY_TOPIC=
# SMTP_URL=
