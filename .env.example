# HyperIdle — environment template (H4).
# Copy to `.env` and adjust per deployment profile.
# Documented in docs/DEPLOYMENT.md.

# --- Deployment profile ---
# laptop | vps | cloud
HYPERIDLE_PROFILE=laptop

# --- Database (laptop profile uses SQLite; vps/cloud use Postgres) ---
# SQLite (laptop): file path
# HYPERIDLE_SQLITE_PATH=./hyperidle.db

# Postgres (vps/cloud): full connection URL
# DATABASE_URL=postgres://hyperidle:hyperidle@localhost:5432/hyperidle

# Postgres connection-pool size. Default 10.
# PG_POOL_SIZE=10

# --- Docker Compose (vps profile) ---
POSTGRES_DB=hyperidle
POSTGRES_USER=hyperidle
# REQUIRED for vps — do not commit a real value.
POSTGRES_PASSWORD=change-me

# --- Server ---
# PORT=3001

# --- Observability (H3) ---
# HYPERIDLE_OBSERVABILITY=console
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=

# --- Notifications (H2) ---
# HYPERIDLE_NOTIFICATIONS=console
# NTFY_TOPIC=
# SMTP_URL=
