# Astro generated types + content sync cache (applications/website)
applications/website/.astro/
.vitepress/cache
# @lore AU28: `scripts/` runs via tsx and is never compiled deliberately, but tsc emits
# declaration + map siblings there transitively (root tsconfig has `include: []`, so
# `scripts/**` is only typechecked through the guard-logic tests in
# `framework/db/src/__tests__/`, which are part of a `composite` project). Those artifacts
# must never reach the tracked tree — a stale emitted `.js` next to a `.ts` also shadows
# the source at resolution time. One rule instead of the per-file list AU28 replaced.
scripts/**/*.js
scripts/**/*.js.map
scripts/**/*.d.ts
scripts/**/*.d.ts.map
!scripts/knip-production-test-files.mjs
# @lore AU26 C3: same class as the guard artifacts above, one level up — a bare
# `tsc -p framework/db` against a stale `dist/` emits declaration MAPS straight
# into the package source tree (`framework/db/src/*.d.ts.map`); ten of them were
# committed once and only a code review caught them. Emitted maps are never
# sources, in any package.
# `.d.ts` itself is deliberately NOT ignored here — hand-written ambient
# declarations are real sources (`layers/core-ui/src/vite-env.d.ts`,
# `window.d.ts`, `framework/design-system/src/css-modules.d.ts`) — except under
# `framework/db/src`, which has none and is the one tree the emit lands in.
layers/*/src/**/*.d.ts.map
layers/*/src/**/*.js.map
layers/*/*/src/**/*.d.ts.map
layers/*/*/src/**/*.js.map
framework/*/src/**/*.d.ts.map
framework/*/src/**/*.js.map
applications/*/src/**/*.d.ts.map
applications/*/src/**/*.js.map
tools/*/src/**/*.d.ts.map
tools/*/src/**/*.js.map
framework/db/src/*.d.ts
# viewer compiled outputs (Vite resolves ./discovery.js → discovery.ts at build/dev time;
# emitted .js/.d.ts/.map files must not be committed)
framework/design-system/viewer/*.js
framework/design-system/viewer/*.d.ts
framework/design-system/viewer/*.js.map
framework/design-system/viewer/*.d.ts.map
# AJ7: same for the annotations/ subdir (the inspector modules)
framework/design-system/viewer/**/*.js
framework/design-system/viewer/**/*.d.ts
framework/design-system/viewer/**/*.js.map
framework/design-system/viewer/**/*.d.ts.map

# AJ5: annotation files (gitignored — founder reviews .annotations/annotations.md locally)
.annotations/

# docs audit working artifacts (not repo content)
.docs-audit/

# Compiled output emitted beside governance sources by composite builds — see
# scripts/rules/no-stale-build-artifacts.ts. Never committed, and the lint fails if present.
scripts/**/*.js
scripts/**/*.d.ts
scripts/**/*.js.map
scripts/**/*.d.ts.map
!scripts/*.mjs
