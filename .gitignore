# plans/ is tracked — pipeline artifacts persist across worktrees and are retired
# at the /write-docs step once their essence lives in docs/ + code. (Was: plans/*)
layers/*/plans/
framework/*/plans/
applications/*/plans/
tools/*/plans/
framework/design-system/03-hearth.html
framework/design-system/inspiration/
hyperidle-pg/
eval-results*.json
